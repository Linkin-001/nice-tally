<template>
  <view class="app-shell" :class="{ dark: isDark }">
    <view class="status-space" :style="{ height: statusHeight + 'px' }" />

    <scroll-view v-if="!db.started && !storageError" class="welcome-scroll">
      <view class="welcome">
        <image class="welcome-art" src="/static/tally/welcome.png" mode="aspectFill" />
        <view class="welcome-brand"><image class="welcome-logo" src="/static/tally/logo.png" /><text class="welcome-title">活动账本</text><text class="welcome-subtitle">记录每一次活动\n让收支更清晰</text></view>
        <view class="welcome-bottom">
          <view class="welcome-feature"><view class="feature-icon"><tally-icon name="shield" tone="green" :size="24" /></view><view><text class="feature-title">完全本地存储</text><text class="muted small">数据只在你的设备中</text></view></view>
          <view class="welcome-feature"><view class="feature-icon"><tally-icon name="wifi" tone="green" :size="24" /></view><view><text class="feature-title">离线也能使用</text><text class="muted small">无需联网，随时记录</text></view></view>
          <view class="welcome-feature"><view class="feature-icon"><tally-icon name="lock" tone="green" :size="24" /></view><view><text class="feature-title">安心记录生活</text><text class="muted small">无需注册，没有广告</text></view></view>
          <button class="primary welcome-start" @click="start(false)">开始使用 →</button>
          <text class="welcome-demo" @click="start(true)">先体验示例账本</text>
        </view>
      </view>
    </scroll-view>

    <view v-else-if="locked || pinMode.length > 0" class="lock-screen">
      <view class="lock-top"><image class="lock-logo" src="/static/tally/logo.png" /><text class="lock-title">{{ lockTitle }}</text><text class="lock-subtitle">{{ lockMessage }}</text></view>
      <view class="pin-dots"><view v-for="n in 6" :key="n" class="pin-dot" :class="{ filled: pinInput.length >= n }" /></view>
      <view class="keypad"><view v-for="key in keys" :key="key" class="key" :class="{ 'key-blank': key == '' }" @click="pressKey(key)"><text v-if="key != 'delete'" class="key-text">{{ key }}</text><tally-icon v-else name="backspace" tone="white" :size="24" /></view></view>
      <text v-if="pinMode.length > 0" class="lock-cancel" @click="cancelPin">取消</text>
      <view v-else class="lock-hint"><tally-icon name="shield" tone="green" :size="20" /><text class="lock-subtitle">密码仅在本机验证</text></view>
    </view>

    <template v-else>
      <view class="header">
        <view v-if="isMain" class="header-brand"><text class="page-title">{{ pageTitle }}</text><text v-if="panel == 'home'" class="tagline">专注于活动收支的本地记账工具</text></view>
        <view v-else class="icon-button" @click="goBack"><tally-icon name="back" :tone="inkTone" /></view>
        <text v-if="!isMain" class="header-title txt">{{ pageTitle }}</text>
        <view class="header-actions">
          <template v-if="panel == 'home' || panel == 'records'"><view class="icon-button" @click="openSearch"><tally-icon name="search" :tone="inkTone" :size="21" /></view><view class="add-small" @click="openEditor(null)"><tally-icon name="plus" tone="white" :size="23" /></view></template>
          <text v-else-if="panel == 'edit'" class="green small" @click="saveActivity(true)">保存草稿</text>
          <text v-else-if="panel == 'detail'" class="green small" @click="editSelected">编辑</text>
          <view v-else-if="panel == 'settings'" class="icon-button" @click="navigate('data')"><tally-icon name="folder" :tone="inkTone" /></view>
          <view v-else class="header-spacer" />
        </view>
      </view>

      <view v-if="storageError" class="error-banner"><text class="error-copy">本地账本读取失败，原数据已保留。请在数据管理中恢复有效备份。</text><text class="green small" @click="navigate('data')">前往恢复 →</text></view>

      <scroll-view class="content-scroll" :scroll-top="scrollTop">
        <view class="content" :class="{ 'content-form': panel == 'edit' }">
          <view v-if="['home', 'records', 'stats', 'people'].includes(panel)" class="month-row"><view class="month-arrow" @click="shiftMonth(-1)"><tally-icon name="back" tone="muted" :size="16" /></view><picker mode="date" fields="month" :value="month + '-01'" start="2000-01-01" end="2100-12-31" @change="monthChanged"><view class="month-label"><text class="txt month-text">{{ monthLabel }}</text><tally-icon name="down" tone="muted" :size="13" /></view></picker><view class="month-arrow" @click="shiftMonth(1)"><tally-icon name="right" tone="muted" :size="16" /></view></view>

          <template v-if="panel == 'home'">
            <view class="card overview-card">
              <view class="section-heading"><text class="section-title txt">本月总览</text><view class="local-label"><view class="live-dot" /><text class="green micro">本地保存</text></view></view>
              <view class="overview-money"><view class="overview-cell"><text class="muted small">收入 <text class="micro">{{ db.preferences.currency }}</text></text><text class="income money-large">{{ money(summary.income) }}</text></view><view class="overview-cell expense-cell"><text class="muted small">支出 <text class="micro">{{ db.preferences.currency }}</text></text><text class="expense money-large">{{ money(summary.expense) }}</text></view></view>
              <view class="net-block"><text class="muted small">净收支</text><text class="net-number" :class="summary.net >= 0 ? 'income' : 'expense'">{{ signedMoney(summary.net) }}</text></view>
              <view class="overview-strip"><view class="strip-cell"><text class="txt strip-number">{{ summary.people }}</text><text class="muted micro">往来人数</text></view><view class="strip-cell strip-border"><text class="txt strip-number">{{ summary.count }}</text><text class="muted micro">活动场次</text></view><view class="strip-cell"><text class="txt strip-number">{{ signedMoney(summary.count > 0 ? Math.round(summary.net / summary.count) : 0) }}</text><text class="muted micro">平均每场</text></view></view>
            </view>
            <view v-if="db.drafts.length > 0" class="draft-banner" @click="openDraft"><tally-icon name="edit" tone="green" :size="18" /><text class="green small flex-one draft-banner-copy">你有 {{ db.drafts.length }} 条未完成的草稿</text><tally-icon name="right" tone="green" :size="16" /></view>
            <view class="card recent-card"><view class="section-heading recent-card-heading"><text class="section-title txt">最近记录</text><text class="muted small" @click="navigate('records')">查看全部 ›</text></view><tally-record v-for="record in visibleRecent" :key="record.id" :record="record" :dark="isDark" @select="showRecord" /><view v-if="monthly.length == 0" class="empty-state"><view class="empty-icon"><tally-icon name="record" tone="green" :size="32" /></view><text class="txt empty-title">把每一次相聚，轻轻记下</text><text class="muted empty-description">这个月还没有记录\n聚餐、运动、朋友小聚，都值得被记住</text><button class="soft-button" @click="openEditor(null)">记第一笔</button></view></view>
            <view class="home-note"><view class="note-line" /><text class="muted note-text">好的记账，是更好的生活</text><view class="note-line" /></view>
            <view class="local-footer"><tally-icon name="shield" tone="green" :size="13" /><text class="muted micro local-footer-copy">只在本机 · 离线可用 · 安心记录</text></view>
          </template>

          <template v-if="panel == 'records'">
            <view class="search-box"><tally-icon name="search" tone="muted" :size="20" /><input v-model="search" class="search-input txt" placeholder="搜索地点、姓名或备注" :focus="searchFocused" :maxlength="60" /><view v-if="search.length > 0" class="clear-search" @click="search = ''"><tally-icon name="close" tone="muted" :size="16" /></view></view>
            <view class="filter-row"><text v-for="f in recordFilters" :key="f" class="filter-chip" :class="{ 'filter-active': recordFilter == f }" @click="recordFilter = f">{{ f }}</text></view>
            <view class="section-heading records-heading"><text class="muted small">{{ recordFilter == '草稿' ? '未完成的活动' : '本月活动明细' }}</text><text class="muted small">共 {{ filteredRecords.length }} 笔</text></view>
            <view v-if="filteredRecords.length > 0" class="card"><view v-for="r in filteredRecords" :key="r.id" class="record-divider"><tally-record :record="r" :dark="isDark" @select="selectListRecord" /></view></view>
            <view v-else class="card empty-state"><tally-icon name="search" tone="muted" :size="34" /><text class="txt empty-title">{{ search.length > 0 ? '没有找到相关记录' : '这里还没有记录' }}</text><text class="muted empty-description">{{ search.length > 0 ? '换个关键词，或切换月份试试' : '点击下方加号，记录一场活动' }}</text></view>
          </template>

          <template v-if="panel == 'edit'">
            <view class="form-group"><text class="field-label muted">时间</text><view class="date-input input-surface"><picker class="date-picker" mode="date" :value="form.date" start="2000-01-01" end="2100-12-31" @change="dateChanged"><text class="txt input-text">{{ form.date.replace(/-/g, '/') }}</text></picker><picker class="date-picker" mode="time" :value="form.time" @change="timeChanged"><text class="txt input-text time-input">{{ form.time }}</text></picker><tally-icon name="calendar" tone="muted" :size="19" /></view></view>
            <view class="form-group"><text class="field-label muted">地点</text><view class="input-surface row"><input v-model="form.place" class="field-input txt" placeholder="活动在哪里？（选填）" :maxlength="60" /><tally-icon name="pin" tone="muted" :size="19" /></view></view>
            <view class="form-group"><text class="field-label muted">活动类型</text><view class="category-grid"><view v-for="(cat, idx) in categories" :key="cat.name" class="category-choice" :class="{ 'category-selected': form.category == cat.name }" @click="form.category = cat.name"><view class="category-symbol" :style="{ backgroundColor: cat.background }"><tally-icon :name="cat.icon" :tone="categoryTones[idx]" :size="22" /></view><text class="category-label" :class="form.category == cat.name ? 'green' : 'muted'">{{ cat.name }}</text></view></view></view>
            <view class="card people-form"><view class="section-heading"><text class="section-title txt">往来对象 <text class="small">({{ form.people.length }})</text></text><text class="green small" @click="chooseContact">从联系人选择 ›</text></view><text class="muted micro amount-explanation">选择收入或支出，填写与对方往来的金额</text>
              <view v-for="(person, idx) in form.people" :key="person.id" class="person-edit-row"><view class="remove-person" @click="removePerson(idx)"><tally-icon name="minus" tone="red" :size="18" /></view><view class="avatar small-avatar" :style="{ backgroundColor: avatarColors[idx % avatarColors.length] }"><text class="avatar-text">{{ person.name.length > 0 ? person.name.substring(0, 1) : '友' }}</text></view><input v-model="person.name" class="person-name-input txt" placeholder="姓名" :maxlength="20" /><button class="direction-toggle" :class="directions[idx] == '收入' ? 'direction-income' : 'direction-expense'" @click="toggleDirection(idx)">{{ directions[idx] }} ⌄</button><input v-model="amounts[idx]" class="amount-input" :class="directions[idx] == '收入' ? 'income' : 'expense'" type="digit" placeholder="0.00" :maxlength="11" /></view>
              <view class="add-person" @click="addPerson"><tally-icon name="plus" tone="green" :size="17" /><text class="green small">添加往来对象</text></view>
            </view>
            <view class="form-group note-group"><text class="field-label muted">备注 <text class="micro">（选填）</text></text><view class="input-surface textarea-surface"><textarea v-model="form.note" class="note-input txt" placeholder="例如：聚餐愉快，气氛很好！" :maxlength="200" /><text class="muted count-label">{{ form.note.length }}/200</text></view></view>
            <text v-if="formError.length > 0" class="expense validation-error">{{ formError }}</text>
            <view class="form-summary"><view><text class="muted micro">总收入</text><text class="income summary-value">{{ money(formTotals.income) }}</text></view><view><text class="muted micro">总支出</text><text class="expense summary-value">{{ money(formTotals.expense) }}</text></view><view><text class="muted micro">净收支</text><text class="txt summary-value">{{ signedMoney(formTotals.net) }}</text></view></view>
          </template>

          <template v-if="panel == 'detail' && selected != null">
            <view class="card detail-hero"><view class="row"><view class="detail-category" :style="{ backgroundColor: categoryFor(selected!.category).background }"><tally-icon :name="categoryFor(selected!.category).icon" :tone="categoryTones[Math.max(0, categories.findIndex(c => c.name == selected!.category))]" :size="31" /></view><view class="flex-one"><text class="txt detail-title">{{ selected!.category }}</text><view class="detail-meta"><tally-icon name="clock" tone="muted" :size="13" /><text class="muted small">{{ selected!.date }}  {{ selected!.time }}</text></view><view class="detail-meta"><tally-icon name="pin" tone="muted" :size="13" /><text class="muted small">{{ selected!.place.length > 0 ? selected!.place : '未填写地点' }}</text></view></view></view><view v-if="selected!.note.length > 0" class="detail-note-inline"><text class="muted small">{{ selected!.note }}</text></view><view class="form-summary detail-summary"><view><text class="muted micro">总收入</text><text class="income summary-value">{{ money(detailTotals.income) }}</text></view><view><text class="muted micro">总支出</text><text class="expense summary-value">{{ money(detailTotals.expense) }}</text></view><view><text class="muted micro">净收支</text><text class="txt summary-value">{{ signedMoney(detailTotals.net) }}</text></view></view></view>
            <view class="card"><text class="section-title txt">往来对象 ({{ selected!.people.length }})</text><view v-for="(p, idx) in selected!.people" :key="p.id" class="person-detail-row"><view class="avatar" :style="{ backgroundColor: avatarColors[idx % avatarColors.length] }"><text class="avatar-text">{{ p.name.substring(0, 1) }}</text></view><text class="txt person-detail-name">{{ p.name }}</text><text class="person-detail-amount" :class="p.cents >= 0 ? 'income' : 'expense'">{{ signedMoney(p.cents) }}</text></view></view>
            <view class="card"><text class="section-title txt">备注</text><text class="muted detail-note">{{ selected!.note.length > 0 ? selected!.note : '这次活动还没有备注。' }}</text></view><view class="local-footer"><tally-icon name="shield" tone="green" :size="13" /><text class="muted micro local-footer-copy">已保存在本机</text></view>
          </template>

          <template v-if="panel == 'stats'">
            <view class="stats-tabs"><view v-for="tab in statsTabs" :key="tab" class="stats-tab" @click="statsTab = tab"><text class="tab-text" :class="statsTab == tab ? 'green active-tab-text' : 'muted'">{{ tab }}</text><view v-if="statsTab == tab" class="active-tab-line" /></view></view>
            <view v-if="statsTab == '总览'" class="card stats-summary"><text class="muted small">本月净收支</text><text class="net-number" :class="summary.net >= 0 ? 'income' : 'expense'">{{ db.preferences.currency }} {{ signedMoney(summary.net) }}</text><text class="muted small stats-summary-caption">{{ summary.count }} 场活动 · {{ summary.people }} 位往来对象</text></view>
            <view v-if="statsTab == '总览' || statsTab == '趋势'" class="card trend-card"><view class="section-heading"><text class="txt section-title">收支趋势</text><view class="chart-legend"><view class="legend-dot income-bg" /><text class="muted micro">收入</text><view class="legend-dot expense-bg" /><text class="muted micro">支出</text></view></view><view class="chart-selected"><text class="muted micro">{{ chartSelection.length > 0 ? chartSelection : '点击柱形，查看当日收支' }}</text></view><view class="trend-chart"><view class="y-labels"><text class="muted axis-label">{{ money(chartMax) }}</text><text class="muted axis-label">0</text><text class="muted axis-label">-{{ money(chartMax) }}</text></view><view class="plot"><view class="chart-guide chart-guide-top" /><view class="chart-guide chart-guide-mid" /><view class="chart-guide chart-guide-bottom" /><view class="bars"><view v-for="bar in trend" :key="bar.day" class="bar-column" @click="selectBar(bar)"><view class="bar-half positive-half"><view class="bar income-bg" :style="{ height: (bar.income / chartMax * 83) + 'px' }" /></view><view class="bar-half"><view class="bar expense-bg" :style="{ height: (bar.expense / chartMax * 83) + 'px' }" /></view></view></view><view class="x-labels"><text v-for="day in axisDays" :key="day" class="muted axis-label">{{ parseInt(month.substring(5)) }}/{{ day }}</text></view></view></view><text v-if="monthly.length == 0" class="muted chart-empty">这个月还没有收支数据</text></view>
            <view v-if="statsTab != '往来对象'" class="card"><view class="section-heading"><text class="txt section-title">收支占比</text><view class="mini-toggle" @click="chartDirection = chartDirection == '支出' ? '收入' : '支出'"><text class="muted small">按{{ chartDirection }}</text><tally-icon name="down" tone="muted" :size="12" /></view></view><view class="distribution"><tally-donut :amounts="categoryAmounts" :colors="categoryColors" :label="'总' + chartDirection" :value="money(chartDirection == '支出' ? summary.expense : summary.income)" :dark="isDark" /><view class="distribution-legend"><view v-for="(cat, idx) in categories" :key="cat.name" class="distribution-row"><view class="legend-dot" :style="{ backgroundColor: categoryColors[idx] }" /><text class="muted small flex-one">{{ cat.name }}</text><text class="txt small">{{ categoryPercent(idx) }}%</text></view></view></view><view v-if="statsTab == '分类'" class="category-breakdown"><view v-for="(cat, idx) in categories" :key="cat.name" class="breakdown-row"><text class="muted small">{{ cat.name }}</text><text class="txt small">{{ db.preferences.currency }} {{ money(categoryAmounts[idx]) }}</text></view></view></view>
            <view v-if="statsTab == '往来对象'" class="card"><view class="section-heading"><text class="txt section-title">往来对象分析</text><text class="green small" @click="navigate('people')">排行榜 ›</text></view><view v-for="(person, idx) in rankedPeople" :key="person.name" class="person-ranking" @click="showPersonRecords(person.name)"><view class="avatar" :style="{ backgroundColor: avatarColors[idx % avatarColors.length] }"><text class="avatar-text">{{ person.name.substring(0, 1) }}</text></view><view class="flex-one"><text class="txt rank-name">{{ person.name }}</text><text class="muted micro">收入 {{ money(person.income) }} · 支出 {{ money(person.expense) }}</text></view><text class="rank-net" :class="person.net >= 0 ? 'income' : 'expense'">{{ signedMoney(person.net) }}</text></view><text v-if="rankedPeople.length == 0" class="muted empty-description">记录活动后，这里会显示往来汇总</text></view>
          </template>

          <template v-if="panel == 'people'">
            <view class="stats-tabs"><view v-for="tab in peopleTabs" :key="tab" class="stats-tab" @click="peopleTab = tab"><text class="small" :class="peopleTab == tab ? 'green active-tab-text' : 'muted'">{{ tab }}</text><view v-if="peopleTab == tab" class="active-tab-line" /></view></view>
            <view class="card ranking-card"><view v-for="(person, idx) in rankedPeople" :key="person.name" class="person-ranking" @click="showPersonRecords(person.name)"><view class="avatar" :style="{ backgroundColor: avatarColors[idx % avatarColors.length] }"><text class="avatar-text">{{ person.name.substring(0, 1) }}</text></view><view class="flex-one"><text class="txt rank-name">{{ person.name }}</text><text class="muted micro rank-caption">收入 {{ money(person.income) }}</text><text class="muted micro">支出 {{ money(person.expense) }}</text></view><view class="rank-right"><text class="rank-net" :class="person.net >= 0 ? 'income' : 'expense'">{{ signedMoney(person.net) }}</text><text class="muted micro rank-caption">{{ person.count }} 次</text></view></view><view v-if="rankedPeople.length == 0" class="empty-state"><tally-icon name="people" tone="muted" :size="32" /><text class="txt empty-title">这个月暂无往来对象</text><text class="muted empty-description">添加活动后，自动统计每个人的收支</text></view></view>
          </template>

          <template v-if="panel == 'settings'">
            <view class="profile-card"><image class="profile-logo" src="/static/tally/logo.png" /><view class="flex-one"><text class="txt profile-title">我的活动账本</text><text class="muted small">{{ db.records.length }} 场活动，珍藏每一次相聚</text></view><view class="local-badge"><tally-icon name="shield" tone="green" :size="14" /><text class="green micro">本地</text></view></view>
            <text class="group-label muted">外观设置</text><view class="card setting-card"><view class="setting-row" @click="chooseTheme"><tally-icon name="moon" :tone="inkTone" :size="21" /><text class="txt setting-label">主题模式</text><text class="muted small">{{ themeLabel }}</text><tally-icon name="right" tone="muted" :size="16" /></view><view class="setting-row" @click="chooseCurrency"><text class="currency-icon txt">{{ db.preferences.currency }}</text><text class="txt setting-label">货币 / 积分符号</text><text class="muted small">{{ db.preferences.currency }}</text><tally-icon name="right" tone="muted" :size="16" /></view><view class="setting-row" @click="chooseDefaultCategory"><tally-icon name="record" :tone="inkTone" :size="21" /><text class="txt setting-label">默认活动类型</text><text class="muted small">{{ db.preferences.category }}</text><tally-icon name="right" tone="muted" :size="16" /></view></view>
            <text class="group-label muted">数据与隐私</text><view class="card setting-card"><view class="setting-row" @click="navigate('data')"><tally-icon name="folder" :tone="inkTone" :size="21" /><text class="txt setting-label">数据管理</text><text class="muted small">备份 / 导出</text><tally-icon name="right" tone="muted" :size="16" /></view><view class="setting-row" @click="configureLock"><tally-icon name="lock" :tone="inkTone" :size="21" /><text class="txt setting-label">应用锁</text><text class="muted small">{{ db.preferences.pinHash.length > 0 ? '已开启' : '未开启' }}</text><tally-icon name="right" tone="muted" :size="16" /></view><view class="setting-row" @click="showPrivacy"><tally-icon name="shield" :tone="inkTone" :size="21" /><text class="txt setting-label">隐私政策</text><tally-icon name="right" tone="muted" :size="16" /></view></view>
            <text class="group-label muted">更多</text><view class="card setting-card"><view class="setting-row" @click="navigate('people')"><tally-icon name="people" :tone="inkTone" :size="21" /><text class="txt setting-label">往来对象分析</text><tally-icon name="right" tone="muted" :size="16" /></view><view class="setting-row" @click="showDisclaimer"><tally-icon name="info" :tone="inkTone" :size="21" /><text class="txt setting-label">使用说明</text><tally-icon name="right" tone="muted" :size="16" /></view><view class="setting-row" @click="showAbout"><tally-icon name="info" :tone="inkTone" :size="21" /><text class="txt setting-label">关于活动账本</text><text class="muted small">v1.0.0</text><tally-icon name="right" tone="muted" :size="16" /></view></view><text class="settings-footer muted">本地 · 安全 · 简单 · 纯粹</text>
          </template>

          <template v-if="panel == 'data'">
            <view class="data-banner"><view class="data-shield"><tally-icon name="shield" tone="green" :size="40" /></view><view><text class="green data-title">数据仅存储在本地</text><text class="muted small">不上报，不上传服务器</text></view></view>
            <view class="storage-summary"><text class="muted small">{{ db.records.length }} 条记录 · {{ db.drafts.length }} 条草稿</text><text class="muted small">{{ storageSize }} KB</text></view>
            <view class="card setting-card data-actions"><view class="setting-row data-row" @click="openExport('backup')"><view class="data-action-icon bg-blue"><tally-icon name="download" tone="blue" /></view><view class="setting-label"><text class="txt setting-name">备份数据</text><text class="muted micro setting-description">导出完整 JSON 备份（未加密）</text></view><tally-icon name="right" tone="muted" :size="16" /></view></view>
            <view class="card setting-card data-actions"><view class="setting-row data-row" @click="openImport"><view class="data-action-icon bg-green"><tally-icon name="upload" tone="green" /></view><view class="setting-label"><text class="txt setting-name">恢复数据</text><text class="muted micro setting-description">从本地备份恢复记录与草稿</text></view><tally-icon name="right" tone="muted" :size="16" /></view></view>
            <view class="card setting-card data-actions"><view class="setting-row data-row" @click="openExport('csv')"><view class="data-action-icon bg-pink"><tally-icon name="record" tone="pink" /></view><view class="setting-label"><text class="txt setting-name">导出 CSV</text><text class="muted micro setting-description">导出可用 Excel 打开的收支明细</text></view><tally-icon name="right" tone="muted" :size="16" /></view></view>
            <view class="card setting-card data-actions"><view class="setting-row data-row" @click="showMigration"><view class="data-action-icon bg-orange"><tally-icon name="copy" tone="orange" /></view><view class="setting-label"><text class="txt setting-name">数据迁移</text><text class="muted micro setting-description">在新设备导入备份文件</text></view><tally-icon name="right" tone="muted" :size="16" /></view></view>
            <view class="card setting-card data-actions"><view class="setting-row data-row" @click="clearData"><view class="data-action-icon bg-red"><tally-icon name="trash" tone="red" /></view><view class="setting-label"><text class="txt setting-name">清空账本数据</text><text class="muted micro setting-description">删除全部记录和草稿，无法撤销</text></view><tally-icon name="right" tone="muted" :size="16" /></view></view>
            <view class="data-footnote"><tally-icon name="shield" tone="green" :size="18" /><text class="muted data-footnote-text">你的数据，始终由你掌控。\n建议定期备份，卸载或清理应用会丢失本地数据。</text></view>
          </template>

          <template v-if="panel == 'transfer'">
            <view class="card transfer-card"><text class="txt section-title">{{ transferMode == 'import' ? '导入本地备份' : '导出你的账本' }}</text><text class="muted transfer-description">{{ transferMode == 'import' ? '选择活动账本 JSON 文件，或粘贴完整备份内容。导入前会检查格式并显示记录数量。' : '文件包含账本明文数据，请保存在你信任的位置。完整备份可用于恢复，CSV 用于查看明细。' }}</text>
              <!-- #ifdef WEB -->
              <button v-if="transferMode == 'import'" class="soft-button file-button" @click="chooseBackupFile">选择 JSON 文件</button>
              <!-- #endif -->
              <textarea v-model="transferText" class="transfer-textarea txt" :disabled="transferMode != 'import'" :maxlength="-1" placeholder="在这里粘贴 JSON 备份内容" />
              <text v-if="transferError.length > 0" class="expense validation-error">{{ transferError }}</text>
              <button v-if="transferMode == 'import'" class="primary transfer-button" @click="restoreBackup">检查并恢复</button>
              <template v-else><button class="primary transfer-button" @click="saveExportFile">保存到文件</button><button class="soft-button transfer-button" @click="copyExport">复制内容</button></template>
            </view>
          </template>
          <view class="content-bottom" />
        </view>
      </scroll-view>

      <view v-if="panel == 'edit'" class="bottom-actions"><button class="soft-button flex-one" @click="saveActivity(true)">保存草稿</button><button class="primary flex-one" @click="saveActivity(false)">保存记录</button></view>
      <view v-else-if="panel == 'detail'" class="bottom-actions detail-actions"><view class="outline-button flex-one" @click="copySelected"><tally-icon name="copy" :tone="inkTone" :size="18" /><text class="txt small">复制</text></view><view class="outline-button flex-one" @click="editSelected"><tally-icon name="edit" :tone="inkTone" :size="18" /><text class="txt small">编辑</text></view><view class="outline-button danger-button flex-one" @click="deleteSelected"><tally-icon name="trash" tone="red" :size="18" /><text class="expense small">删除</text></view></view>
      <view v-else-if="isMain" class="tabbar"><view class="nav-item" @click="navigate('home')"><tally-icon name="home" :tone="panel == 'home' ? 'green' : 'muted'" :size="23" /><text class="nav-label" :class="panel == 'home' ? 'green' : 'muted'">首页</text></view><view class="nav-item" @click="navigate('records')"><tally-icon name="record" :tone="panel == 'records' ? 'green' : 'muted'" :size="22" /><text class="nav-label" :class="panel == 'records' ? 'green' : 'muted'">记录</text></view><view class="nav-add-slot"><view class="nav-add" @click="openEditor(null)"><tally-icon name="plus" tone="white" :size="29" /></view></view><view class="nav-item" @click="navigate('stats')"><tally-icon name="chart" :tone="panel == 'stats' ? 'green' : 'muted'" :size="23" /><text class="nav-label" :class="panel == 'stats' ? 'green' : 'muted'">统计</text></view><view class="nav-item" @click="navigate('settings')"><tally-icon name="user" :tone="panel == 'settings' ? 'green' : 'muted'" :size="22" /><text class="nav-label" :class="panel == 'settings' ? 'green' : 'muted'">我的</text></view></view>
    </template>
  </view>
</template>

<script setup lang="uts">
import { Activity, PersonEntry, Ledger, PersonTotal, categories, avatarColors, STORAGE_KEY, emptyLedger, identifier, today, money, signedMoney, parseMoney, categoryFor, totals, monthRecords, peopleTotals, newActivity, cloneLedger, cloneActivity, activityError, parseLedger, persistLedger, backupText, csvText, sampleRecords, pad } from '@/common/tally/ledger.uts'
import { session } from '@/common/tally/session.uts'
import { pinVerifier } from '@/common/tally/sha256.uts'
type TrendBar = { day: number, income: number, expense: number }
const db = ref<Ledger>(emptyLedger())
const storageError = ref(false)
const panel = ref('home')
const previousPanel = ref('home')
const selectedId = ref('')
const month = ref(today().substring(0, 7))
const search = ref('')
const searchFocused = ref(false)
const scrollTop = ref(0)
const recordFilter = ref('全部')
const recordFilters = ['全部', '净收入', '净支出', '草稿']
const statsTabs = ['总览', '趋势', '分类', '往来对象']
const statsTab = ref('趋势')
const peopleTabs = ['全部', '收入排行', '支出排行', '净收支排行']
const peopleTab = ref('全部')
const chartDirection = ref('支出')
const chartSelection = ref('')
const categoryTones = ['orange', 'green', 'blue', 'pink', 'gold', 'muted']
const categoryColors = ['#ff7278', '#00bb83', '#69abf8', '#faad5a', '#d5b565', '#c1cbd4']
const statusHeight = uni.getWindowInfo().statusBarHeight
const systemDark = ref(uni.getSystemInfoSync().osTheme == 'dark')
const isDark = computed((): boolean => db.value.preferences.theme == 'dark' || (db.value.preferences.theme == 'system' && systemDark.value))
const inkTone = computed((): string => isDark.value ? 'white' : 'ink')
const locked = computed((): boolean => db.value.preferences.pinHash.length > 0 && session.locked)
const isMain = computed((): boolean => ['home', 'records', 'stats', 'settings'].includes(panel.value))
const pageTitle = computed((): string => { if (panel.value == 'home') return '活动账本'; if (panel.value == 'records') return '活动记录'; if (panel.value == 'edit') return editing.value ? '编辑活动记录' : '新增活动记录'; if (panel.value == 'detail') return '记录详情'; if (panel.value == 'stats') return '统计分析'; if (panel.value == 'people') return '往来对象分析'; if (panel.value == 'data') return '数据管理'; if (panel.value == 'transfer') return transferMode.value == 'import' ? '恢复数据' : '导出数据'; return '设置' })
const monthLabel = computed((): string => month.value.substring(0, 4) + '年' + parseInt(month.value.substring(5)).toString() + '月')
const themeLabel = computed((): string => db.value.preferences.theme == 'light' ? '明亮模式' : db.value.preferences.theme == 'dark' ? '深色模式' : '跟随系统')
const monthly = computed((): Activity[] => monthRecords(db.value.records, month.value))
const summary = computed(() => totals(monthly.value))
const visibleRecent = computed(() => monthly.value.slice(0, 5))
const selected = computed((): Activity | null => db.value.records.find((r: Activity): boolean => r.id == selectedId.value) ?? null)
const detailTotals = computed(() => totals(selected.value == null ? [] : [selected.value!]))
const storageSize = computed((): string => (JSON.stringify(db.value).length * 2 / 1024).toFixed(1))
const filteredRecords = computed((): Activity[] => {
  let list = recordFilter.value == '草稿' ? db.value.drafts.slice() : monthly.value.slice()
  if (recordFilter.value == '净收入') list = list.filter((r: Activity): boolean => totals([r]).net >= 0)
  if (recordFilter.value == '净支出') list = list.filter((r: Activity): boolean => totals([r]).net < 0)
  const query = search.value.trim().toLowerCase()
  if (query.length > 0) list = list.filter((r: Activity): boolean => (r.place + r.category + r.note + r.people.map((p: PersonEntry): string => p.name).join(' ')).toLowerCase().includes(query))
  return list
})
const rankedPeople = computed((): PersonTotal[] => {
  const entries = peopleTotals(monthly.value)
  if (peopleTab.value == '收入排行') entries.sort((a: PersonTotal, b: PersonTotal): number => b.income - a.income)
  if (peopleTab.value == '支出排行') entries.sort((a: PersonTotal, b: PersonTotal): number => b.expense - a.expense)
  if (peopleTab.value == '净收支排行') entries.sort((a: PersonTotal, b: PersonTotal): number => b.net - a.net)
  return entries
})
const trend = computed((): TrendBar[] => {
  const days = new Date(parseInt(month.value.substring(0, 4)), parseInt(month.value.substring(5)), 0).getDate()
  const bars: TrendBar[] = []
  for (let i = 1; i <= days; i++) { const values = totals(monthly.value.filter((r: Activity): boolean => parseInt(r.date.substring(8)) == i)); bars.push({ day: i, income: values.income, expense: values.expense }) }
  return bars
})
const chartMax = computed((): number => { let max = 10000; trend.value.forEach((b: TrendBar) => { max = Math.max(max, b.income, b.expense) }); return Math.ceil(max / 10000) * 10000 })
const axisDays = computed((): number[] => [1, 8, 15, 22, trend.value.length])
const categoryAmounts = computed((): number[] => categories.map((cat): number => { const values = totals(monthly.value.filter((r: Activity): boolean => r.category == cat.name)); return chartDirection.value == '支出' ? values.expense : values.income }))
function categoryPercent(index: number): string { const sum = chartDirection.value == '支出' ? summary.value.expense : summary.value.income; return sum == 0 ? '0' : (categoryAmounts.value[index] / sum * 100).toFixed(0) }
function selectBar(bar: TrendBar) { chartSelection.value = monthLabel.value + bar.day.toString() + '日  收入 ' + money(bar.income) + ' · 支出 ' + money(bar.expense) }

function toast(title: string) { uni.showToast({ title: title, icon: 'none' }) }
function commit(next: Ledger): boolean { if (storageError.value) { toast('请先恢复有效备份，避免覆盖原始数据'); return false }; if (!persistLedger(next)) return false; db.value = next; return true }
function load() {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    if (raw == null || raw == '') return
    if (typeof raw != 'string') { storageError.value = true; db.value.started = true; return }
    const parsed = parseLedger(raw as string)
    if (parsed == null) { storageError.value = true; db.value.started = true; return }
    db.value = parsed
  } catch (e) { storageError.value = true; db.value.started = true }
}
load()
onShow(() => { systemDark.value = uni.getSystemInfoSync().osTheme == 'dark' })
onBackPress((): boolean => { if (locked.value || pinMode.value.length > 0) return true; if (panel.value != 'home') { goBack(); return true }; return false })
function start(sample: boolean) { const next = cloneLedger(db.value); next.started = true; if (sample) next.records = sampleRecords(); if (commit(next)) { session.locked = false; panel.value = 'home' } }
function navigate(target: string) { panel.value = target; searchFocused.value = false; scrollTop.value = 0 }
function goBack() {
  if (panel.value == 'edit') {
    if (editorSnapshot.value == currentEditorSnapshot()) { navigate(previousPanel.value); return }
    uni.showModal({ title: '离开编辑？', content: '尚未保存的修改会丢失，你也可以取消后保存为草稿。', confirmText: '放弃修改', success: (res) => { if (res.confirm) navigate(previousPanel.value) } }); return
  }
  if (panel.value == 'transfer') { navigate('data'); return }
  if (panel.value == 'detail') { navigate(previousPanel.value == 'edit' ? 'records' : previousPanel.value); return }
  if (panel.value == 'data' || panel.value == 'people') { navigate('settings'); return }
  navigate('home')
}
function shiftMonth(offset: number) { const date = new Date(parseInt(month.value.substring(0, 4)), parseInt(month.value.substring(5)) - 1 + offset, 1); if (date.getFullYear() < 2000 || date.getFullYear() > 2100) return; month.value = date.getFullYear().toString() + '-' + pad(date.getMonth() + 1); chartSelection.value = '' }
function monthChanged(event: UniPickerChangeEvent) { month.value = (event.detail.value as string).substring(0, 7); chartSelection.value = '' }
function openSearch() { navigate('records'); searchFocused.value = true }
function showRecord(id: string) { previousPanel.value = panel.value; selectedId.value = id; navigate('detail') }
function selectListRecord(id: string) { if (recordFilter.value == '草稿') { const draft = db.value.drafts.find((r: Activity): boolean => r.id == id); if (draft != null) openEditor(draft) } else showRecord(id) }
function showPersonRecords(name: string) { search.value = name; recordFilter.value = '全部'; navigate('records') }

const form = ref<Activity>(newActivity('聚餐'))
const amounts = ref<string[]>([''])
const directions = ref<string[]>(['支出'])
const editing = ref(false)
const formError = ref('')
const editorSnapshot = ref('')
function currentEditorSnapshot(): string { return JSON.stringify(form.value) + JSON.stringify(amounts.value) + JSON.stringify(directions.value) }
const formTotals = computed(() => { let income = 0; let expense = 0; amounts.value.forEach((value: string, i: number) => { const cents = parseMoney(value); if (cents != null && cents >= 0) { if (directions.value[i] == '收入') income += cents; else expense += cents } }); return { income: income, expense: expense, net: income - expense } })
function openEditor(record: Activity | null) {
  previousPanel.value = panel.value
  form.value = record == null ? newActivity(db.value.preferences.category) : cloneActivity(record)
  editing.value = record != null && db.value.records.some((r: Activity): boolean => r.id == record.id)
  amounts.value = form.value.people.map((p: PersonEntry): string => p.cents == 0 ? '' : money(Math.abs(p.cents)))
  directions.value = form.value.people.map((p: PersonEntry): string => p.cents > 0 ? '收入' : '支出')
  formError.value = ''; editorSnapshot.value = currentEditorSnapshot(); navigate('edit')
}
function openDraft() { if (db.value.drafts.length == 1) openEditor(db.value.drafts[0]); else { recordFilter.value = '草稿'; search.value = ''; navigate('records') } }
function dateChanged(event: UniPickerChangeEvent) { form.value.date = event.detail.value as string }
function timeChanged(event: UniPickerChangeEvent) { form.value.time = event.detail.value as string }
function addPerson() { if (form.value.people.length >= 50) { toast('每场活动最多 50 人'); return }; form.value.people.push({ id: identifier(), name: '', cents: 0 }); amounts.value.push(''); directions.value.push('支出') }
function removePerson(index: number) { if (form.value.people.length == 1) { toast('请至少保留一位往来对象'); return }; form.value.people.splice(index, 1); amounts.value.splice(index, 1); directions.value.splice(index, 1) }
function toggleDirection(index: number) { directions.value[index] = directions.value[index] == '收入' ? '支出' : '收入' }
function chooseContact() {
  const contacts = peopleTotals(db.value.records).filter((p: PersonTotal): boolean => !form.value.people.some((entry: PersonEntry): boolean => entry.name == p.name)).slice(0, 6)
  if (contacts.length == 0) { toast('联系人来自历史记录，也可以直接输入姓名'); return }
  uni.showActionSheet({ itemList: contacts.map((p: PersonTotal): string => p.name), success: (res) => { const empty = form.value.people.findIndex((p: PersonEntry): boolean => p.name.length == 0); if (empty >= 0) form.value.people[empty].name = contacts[res.tapIndex].name; else if (form.value.people.length < 50) { addPerson(); form.value.people[form.value.people.length - 1].name = contacts[res.tapIndex].name } } })
}
function saveActivity(draft: boolean) {
  formError.value = ''
  const record = cloneActivity(form.value)
  for (let i = 0; i < record.people.length; i++) {
    const value = amounts.value[i].trim(); const amount = draft && value.length == 0 ? 0 : parseMoney(value)
    if (amount == null || amount < 0) { formError.value = '请输入有效的正数金额，收支方向请用左侧按钮切换'; return }
    record.people[i].cents = directions.value[i] == '支出' ? -amount : amount
    record.people[i].name = record.people[i].name.trim()
  }
  const error = activityError(record, draft)
  if (error.length > 0) { formError.value = error; return }
  record.updatedAt = Date.now(); record.place = record.place.trim(); record.note = record.note.trim()
  const next = cloneLedger(db.value)
  next.drafts = next.drafts.filter((r: Activity): boolean => r.id != record.id)
  if (draft) next.drafts.unshift(record)
  else { next.records = next.records.filter((r: Activity): boolean => r.id != record.id); next.records.unshift(record) }
  if (!commit(next)) return
  editorSnapshot.value = currentEditorSnapshot(); month.value = record.date.substring(0, 7)
  toast(draft ? '草稿已保存到本地' : '记录已保存到本地')
  if (draft) navigate('home'); else { selectedId.value = record.id; previousPanel.value = 'records'; navigate('detail') }
}
function editSelected() { if (selected.value != null) openEditor(selected.value!) }
function copySelected() { if (selected.value == null) return; const record = cloneActivity(selected.value!); record.id = identifier(); record.date = today(); record.people.forEach((p: PersonEntry) => { p.id = identifier() }); openEditor(record); editing.value = false }
function deleteSelected() { if (selected.value == null) return; const id = selectedId.value; uni.showModal({ title: '删除这条记录？', content: '删除后无法撤销，本月统计会同步更新。', confirmText: '删除', confirmColor: '#f25b67', success: (res) => { if (!res.confirm) return; const next = cloneLedger(db.value); next.records = next.records.filter((r: Activity): boolean => r.id != id); next.drafts = next.drafts.filter((r: Activity): boolean => r.id != id); if (commit(next)) { navigate('records'); toast('记录已删除') } } }) }

function chooseTheme() { uni.showActionSheet({ itemList: ['明亮模式', '深色模式', '跟随系统'], success: (res) => { const next = cloneLedger(db.value); next.preferences.theme = ['light', 'dark', 'system'][res.tapIndex]; commit(next) } }) }
function chooseCurrency() { uni.showActionSheet({ itemList: ['人民币 ¥', '美元 / 积分 $', '欧元 €'], success: (res) => { const next = cloneLedger(db.value); next.preferences.currency = ['¥', '$', '€'][res.tapIndex]; if (commit(next)) toast('仅修改显示符号，不换算历史金额') } }) }
function chooseDefaultCategory() { uni.showActionSheet({ itemList: categories.map((c): string => c.name), success: (res) => { const next = cloneLedger(db.value); next.preferences.category = categories[res.tapIndex].name; commit(next) } }) }
function showPrivacy() { uni.showModal({ title: '隐私政策', content: '活动账本不注册账号，不收集或上传账本、姓名、地点与备注，不接入广告或统计上报。所有记录和设置存储在当前设备。应用锁用于防止他人直接浏览界面，不会加密底层账本；JSON 和 CSV 导出也未加密。卸载应用或清理浏览器数据可能删除账本，请自行妥善备份。', showCancel: false }) }
function showDisclaimer() { uni.showModal({ title: '记账说明', content: '金额以你的视角记录：收到的钱选“收入”，付出的钱选“支出”。本月总收入、总支出按所有往来明细合计，净收支为二者之差，平均每场为净收支除以活动场次。货币符号仅用于显示，不提供汇率换算。应用仅帮助个人记账，不处理付款或结算。', showCancel: false }) }
function showAbout() { uni.showModal({ title: '活动账本 v1.0.0', content: '记录每一次活动，让收支更清晰。\n\n本地 · 安全 · 简单 · 纯粹\n\n基于 uni-app x 开发。无需账号，离线可用。', showCancel: false }) }

const transferMode = ref('backup')
const transferText = ref('')
const transferError = ref('')
function openExport(mode: string) { if (storageError.value) { toast('请先恢复有效备份'); return }; transferMode.value = mode; transferText.value = mode == 'csv' ? csvText(db.value) : backupText(db.value); transferError.value = ''; navigate('transfer') }
function openImport() { transferMode.value = 'import'; transferText.value = ''; transferError.value = ''; navigate('transfer') }
function copyExport() { uni.setClipboardData({ data: transferText.value, success: () => toast('已复制，请妥善保存账本内容'), fail: () => toast('复制失败，请手动保存文件') }) }
function saveExportFile() {
  const name = '活动账本-' + today() + (transferMode.value == 'csv' ? '.csv' : '.json')
  // #ifdef WEB
  const blob = new Blob([transferText.value], { type: transferMode.value == 'csv' ? 'text/csv;charset=utf-8' : 'application/json;charset=utf-8' })
  const url = URL.createObjectURL(blob); const anchor = document.createElement('a'); anchor.href = url; anchor.download = name; document.body.appendChild(anchor); anchor.click(); anchor.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000)
  // #endif
  // #ifndef WEB
  const filePath = uni.env.USER_DATA_PATH + '/' + name
  uni.getFileSystemManager().writeFile({ filePath: filePath, data: transferText.value, encoding: 'utf-8', success: () => { uni.showModal({ title: '文件已保存到本机', content: filePath + '\n\n请复制或转存到应用外保存，避免卸载时丢失。也可以使用“复制内容”迁移。', showCancel: false }) }, fail: () => toast('保存文件失败，请使用复制内容') })
  // #endif
}
// #ifdef WEB
function chooseBackupFile() {
  const input = document.createElement('input'); input.type = 'file'; input.accept = '.json,application/json'
  input.onchange = () => { const files = input.files; if (files == null || files.length == 0) return; const file = files[0]; if (file.size > 20 * 1024 * 1024) { transferError.value = '备份文件不能超过 20 MB'; return }; const reader = new FileReader(); reader.onload = () => { transferText.value = reader.result as string; transferError.value = '' }; reader.onerror = () => { transferError.value = '文件读取失败，请重试' }; reader.readAsText(file) }
  input.click()
}
// #endif
function restoreBackup() {
  transferError.value = ''
  const incoming = parseLedger(transferText.value)
  if (incoming == null) { transferError.value = '备份无效：请使用活动账本 v1 的完整 JSON 备份，CSV 无法用于恢复。原有数据未修改。'; return }
  uni.showModal({ title: '确认恢复备份', content: '将导入 ' + incoming.records.length.toString() + ' 条记录和 ' + incoming.drafts.length.toString() + ' 条草稿，替换当前账本。建议先备份现有数据。应用锁密码保持不变。', confirmText: '恢复备份', success: (res) => { if (!res.confirm) return; incoming.started = true; incoming.preferences.pinHash = db.value.preferences.pinHash; incoming.preferences.pinSalt = db.value.preferences.pinSalt; incoming.preferences.failedAttempts = db.value.preferences.failedAttempts; incoming.preferences.blockedUntil = db.value.preferences.blockedUntil; if (persistLedger(incoming)) { storageError.value = false; db.value = incoming; month.value = incoming.records.length > 0 ? incoming.records[0].date.substring(0, 7) : today().substring(0, 7); transferText.value = ''; navigate('home'); toast('备份已恢复到本机') } } })
}
function showMigration() { uni.showModal({ title: '把账本带到新设备', content: '1. 在本机使用“备份数据”导出 JSON 文件。\n2. 将文件通过你信任的方式传到新设备。\n3. 在新设备打开“恢复数据”，选择文件或粘贴备份内容。\n\n备份文件未加密，不包含应用锁密码。迁移过程不会经过活动账本服务器。', showCancel: false }) }
function clearData() { uni.showModal({ title: '清空所有账本数据？', content: '将永久删除 ' + db.value.records.length.toString() + ' 条记录及所有草稿，无法撤销。请先保存备份。外观与应用锁设置将保留。', confirmText: '清空记录', confirmColor: '#f25b67', success: (res) => { if (!res.confirm) return; const next = cloneLedger(db.value); next.records = []; next.drafts = []; if (commit(next)) toast('账本已清空') } }) }

const pinMode = ref('')
const pinInput = ref('')
const firstPin = ref('')
const pinError = ref('')
const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '', '0', 'delete']
const lockTitle = computed((): string => pinMode.value == 'setup' ? '设置六位密码' : pinMode.value == 'confirm' ? '再次输入密码' : pinMode.value == 'disable' ? '验证当前密码' : '输入密码')
const lockMessage = computed((): string => pinError.value.length > 0 ? pinError.value : pinMode.value == 'setup' || pinMode.value == 'confirm' ? '请记住密码，忘记后无法找回' : '保护你的账本数据')
function configureLock() { pinInput.value = ''; pinError.value = ''; firstPin.value = ''; if (db.value.preferences.pinHash.length == 0) pinMode.value = 'setup'; else uni.showActionSheet({ itemList: ['立即锁定', '关闭应用锁'], success: (res) => { if (res.tapIndex == 0) session.locked = true; else pinMode.value = 'disable' } }) }
function cancelPin() { pinMode.value = ''; pinInput.value = ''; firstPin.value = ''; pinError.value = '' }
function pressKey(key: string) {
  if (key == '') return
  if (key == 'delete') { pinInput.value = pinInput.value.substring(0, Math.max(0, pinInput.value.length - 1)); return }
  if (Date.now() < db.value.preferences.blockedUntil) { pinError.value = '请 ' + Math.ceil((db.value.preferences.blockedUntil - Date.now()) / 1000).toString() + ' 秒后重试'; return }
  if (pinInput.value.length >= 6) return
  pinError.value = ''; pinInput.value += key
  if (pinInput.value.length == 6) setTimeout(() => verifyPin(), 60)
}
function verifyPin() {
  if (pinInput.value.length != 6) return
  if (pinMode.value == 'setup') { firstPin.value = pinInput.value; pinInput.value = ''; pinMode.value = 'confirm'; return }
  const next = cloneLedger(db.value)
  if (pinMode.value == 'confirm') {
    if (pinInput.value != firstPin.value) { pinError.value = '两次密码不一致，请重新设置'; pinInput.value = ''; firstPin.value = ''; pinMode.value = 'setup'; return }
    next.preferences.pinSalt = identifier() + identifier(); next.preferences.pinHash = pinVerifier(next.preferences.pinSalt, pinInput.value); next.preferences.failedAttempts = 0; next.preferences.blockedUntil = 0
    if (commit(next)) { session.locked = false; cancelPin(); toast('应用锁已开启') }; return
  }
  if (pinVerifier(next.preferences.pinSalt, pinInput.value) != next.preferences.pinHash) {
    next.preferences.failedAttempts++
    if (next.preferences.failedAttempts >= 5) { next.preferences.blockedUntil = Date.now() + 60000; next.preferences.failedAttempts = 0 }
    commit(next); pinInput.value = ''; pinError.value = next.preferences.blockedUntil > Date.now() ? '多次输入错误，请 60 秒后重试' : '密码不正确，请重试'; return
  }
  next.preferences.failedAttempts = 0; next.preferences.blockedUntil = 0
  if (pinMode.value == 'disable') { next.preferences.pinHash = ''; next.preferences.pinSalt = '' }
  if (commit(next)) { session.locked = false; cancelPin() }
}
</script>

<style src="@/common/tally/tally.css"></style>
