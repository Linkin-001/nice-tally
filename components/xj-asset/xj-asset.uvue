<template><view class="asset-box" :style="{ width: size + 'px', height: size + 'px', backgroundColor: tint }"><image v-if="ready" :src="path" :style="{ width: size + 'px', height: size + 'px' }" mode="aspectFit" /></view></template>
<script setup lang="ts">
import { suppliedAssets, assetPath } from '@/common/xiaojin/assets'
const props = defineProps({name:{type:String,default:'book'},size:{type:Number,default:40},tint:{type:String,default:'#F9E8ED'}})
const ready=computed(()=>suppliedAssets.includes(props.name))
const path=computed(()=>assetPath(props.name))
</script>
<style>.asset-box { border-radius: 13px; flex-shrink: 0; align-items: center; justify-content: center; }</style>
