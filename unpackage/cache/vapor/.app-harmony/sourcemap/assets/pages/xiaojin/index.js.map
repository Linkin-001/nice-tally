	function toggleFieldKind(k : string) { const i = fieldForm.value.kinds.indexOf(k); if (i < 0) fieldForm.value.kinds.push(k); else fieldForm.value.kinds.splice(i, 1) }
	function submitField() { const f = clone(fieldForm.value); f.name = f.name.trim(); f.options = [...new Set(fieldOptionsText.value.split('\n').map(v => v.trim()).filter(Boolean))]; if (!f.name) { error.value = '请填写字段名称'; return } if (['单选', '多选'].includes(f.type) && !f.options.length) { error.value = '请至少添加一个选项'; return } if (f.conditionField && !f.conditionValue) { error.value = '请设置条件匹配值'; return } if (commit(s => { const b = currentBook(s, bookId.value); if (b.fields.some(v => v.id !== f.id && !v.deleted && v.name === f.name)) throw new Error('字段名称已存在'); const i = b.fields.findIndex(v => v.id === f.id); if (i < 0) b.fields.push(f); else b.fields[i] = f })) { page.value = 'fields'; toast('字段已保存') } }
	function deleteField() { openSheet('delete-field', '删除「' + fieldForm.value.name + '」？', '字段不再出现在新表单中，历史记录中的字段名称和值继续保留。', [{ label: '删除字段，保留历史值', value: 'confirm', danger: true }]) }
	function moveField(f : Field, step : number) { if (book.value?.fields.some(v => v.conditionField === f.id) || f.conditionField) { error.value = '含条件依赖的字段暂不支持调整顺序'; return } commit(s => { const fs = currentBook(s, bookId.value).fields.sort((a, b) => a.order - b.order); const i = fs.findIndex(v => v.id === f.id); const j = i + step; if (j < 0 || j >= fs.length) return;[fs[i], fs[j]] = [fs[j], fs[i]]; fs.forEach((v, n) => v.order = n) }) }
	const catalogKind = ref('expense'), entitySearch = ref(''), entityForm = ref<Entity>({} as Entity)
	const catalogEntities = computed(() => book.value?.entities.filter(e => e.kind === catalogKind.value && e.name.includes(entitySearch.value)) || []), parentOptions = computed(() => book.value?.entities.filter(e => e.kind === entityForm.value.kind && !e.parentId && e.id !== entityForm.value.id) || [])
	function openCatalog(kind : string) { if (!book.value) { go('books'); return } catalogKind.value = kind; entitySearch.value = ''; go('catalog') }
	function newEntity() { entityForm.value = { id: id(), name: '', kind: catalogKind.value, icon: 'book', color: accent.value, enabled: true, parentId: '', note: '' }; go('entity-edit') }
	function showEntity(e : Entity) { entityForm.value = clone(e); go('entity-detail') }
	function submitEntity() { if (!entityForm.value.name.trim()) { error.value = '请填写名称'; return } if (commit(s => { const b = currentBook(s, bookId.value); const e = clone(entityForm.value); e.name = e.name.trim(); if (b.entities.some(v => v.id !== e.id && v.kind === e.kind && v.name === e.name)) throw new Error('名称已存在'); const i = b.entities.findIndex(v => v.id === e.id); if (i < 0) b.entities.push(e); else b.entities[i] = e })) { page.value = 'catalog'; toast('配置已保存') } }
	function toggleEntity() { entityForm.value.enabled = !entityForm.value.enabled; submitEntity() }
	const entityRecords = computed(() => space.value?.transactions.filter(t => t.bookId === bookId.value && !t.draft && [t.categoryId, t.objectId, t.accountId, t.toAccountId].includes(entityForm.value.id)) || []), entityTotals = computed(() => summary(entityRecords.value))
	const statKind = ref('expense'), reportForm = ref<Report>({} as Report)
	const metricOptions = ['sum', 'count', 'avg', 'max', 'min'], metricLabels = ['金额合计', '记录笔数', '平均金额', '最大金额', '最小金额'], chartOptions = ['line', 'bar', 'donut', 'rank', 'number'], chartLabels = ['折线图', '柱状图', '饼图', '排行榜', '数字指标']
	const dimensions = computed(() => [{ id: 'category', name: '分类' }, { id: 'account', name: '支付方式' }, { id: 'object', name: '往来对象' }, { id: 'date', name: '按日' }, { id: 'month', name: '按月' }, ...(book.value?.fields.filter(f => f.statistical && !f.deleted).map(f => ({ id: f.id, name: f.name })) || [])])
	const metricFields = computed(() => [{ id: '', name: '交易金额' }, ...(book.value?.fields.filter(f => f.statistical && !f.deleted && ['数字', '金额', '星级'].includes(f.type)).map(f => ({ id: f.id, name: f.name })) || [])])
	const reportCategories = computed(() => [{ id: '', name: '全部分类' }, ...(book.value?.entities.filter(e => ['expense', 'income'].includes(e.kind)).map(e => ({ id: e.id, name: e.name })) || [])])
	const defaultReport = computed(() => ({ ...newReport(book.value || ({ id: '' } as Book)), kind: statKind.value, period: period.value })), defaultGroups = computed(() => space.value && book.value ? aggregate(space.value, defaultReport.value) : []), reportPreview = computed(() => space.value && reportForm.value.id ? aggregate(space.value, reportForm.value) : [])
	function createReport() { if (!book.value) return; reportForm.value = newReport(book.value); go('report-edit') }
	function editReport(r : Report) { reportForm.value = clone(r); go('report-edit') }
	function viewReport(r : Report) { reportForm.value = clone(r); go('report-view') }
	function toggleReportBook(key : string) { const r = reportForm.value; const i = r.bookIds.indexOf(key); if (i < 0) { if (r.metric !== 'count' && space.value!.books.some(b => r.bookIds.includes(b.id) && b.currency !== currentBook(space.value!, key).currency)) { error.value = '不同币种不能直接合计，请分别创建统计方案'; return } r.bookIds.push(key) } else r.bookIds.splice(i, 1) }
	function submitReport() { const r = clone(reportForm.value); if (!r.name.trim() || !r.bookIds.length) { error.value = '请填写方案名称并选择至少一个账本'; return } if (r.metric !== 'count' && new Set(space.value!.books.filter(b => r.bookIds.includes(b.id)).map(b => b.currency)).size > 1) { error.value = '不同币种不能直接合计，请分别创建方案'; return } if (r.chart === 'donut' && (['date', 'month'].includes(r.dimension) || reportPreview.value.some(g => g.value < 0))) { error.value = '时间趋势或负数请使用折线图或柱状图'; return } if (r.chart === 'line' && !['date', 'month'].includes(r.dimension)) { error.value = '折线图需要按日或按月的时间维度'; return } if (commit(s => { const b = currentBook(s, bookId.value); const i = b.reports.findIndex(v => v.id === r.id); if (i < 0) b.reports.push(r); else b.reports[i] = r })) { page.value = 'stats'; toast('统计方案已保存') } }
	const drillIds = ref<string[]>([]), drillName = ref(''), drillRecords = computed(() => space.value?.transactions.filter(t => drillIds.value.includes(t.id)) || [])
	function drillInto(g : any, r : Report) { drillIds.value = g.ids; drillName.value = g.name; go('drill') }
	const budgetInput = ref(''), budgetPercent = computed(() => book.value?.budget ? Math.round(totals.value.expense / book.value.budget * 100) : 0)
	function saveBudget() { try { const value = cents(budgetInput.value); if (commit(s => currentBook(s, bookId.value).budget = value)) toast('预算已保存') } catch (e) { error.value = message(e) } }
	const themeDraft = ref(themes[0].color)
	function saveTheme() { if (commit(s => s.theme = themeDraft.value)) toast('主题已更新') }
	function setEntry(index : number) { commit(s => s.entry = ['password', 'logo', 'version'][index]) }
	let taps = 0
	function versionTap() { taps++; if (taps >= 5) { taps = 0; lockNow() } }
	const oldPassword = ref(''), newPassword = ref(''), confirmPassword = ref('')
	async function submitPassword() { if (busy.value) return; if (newPassword.value !== confirmPassword.value) { error.value = '两次新密码不一致'; return } busy.value = true; try { await vault.changePinAsync(space.value!, oldPassword.value, newPassword.value); oldPassword.value = ''; newPassword.value = ''; confirmPassword.value = ''; page.value = 'security'; toast('密码已修改') } catch (e) { error.value = message(e) } finally { busy.value = false } }
	const exportText = ref(''), importText = ref(''), backupPassword = ref(''), importPreview = ref<Space | null>(null), restoreMode = ref('merge'), restorePin = ref('')
	watch([importText, backupPassword], () => { importPreview.value = null })
	function exportBackup() { try { exportText.value = vault.backup(space.value!); toast('已生成加密备份') } catch (e) { error.value = message(e) } }
	function copyBackup() { uni.setClipboardData({ data: exportText.value, success: () => toast('已复制加密备份') }) }
	function saveBackupFile() {




		const path = uni.env.USER_DATA_PATH + '/xiaojin-' + Date.now() + '.xjbackup'; uni.getFileSystemManager().writeFile({ filePath: path, data: exportText.value, encoding: 'utf-8', success: () => { error.value = '加密文件已保存到 ' + path + '。卸载应用会删除该目录，请另行复制加密内容到独立安全位置。' }, fail: () => { error.value = '备份写入失败，请检查存储空间，或复制加密内容保存。' } })

	}
	function chooseBackup() {




		const epoch = generation; uni.chooseFile({ count: 1, type: 'all', success: (res : any) => { if (epoch !== generation) return; const file = res.tempFiles[0]; if (!file) return; if (file.size > 20 * 1024 * 1024) { error.value = '文件超过 20 MB'; return } uni.getFileSystemManager().readFile({ filePath: file.path, encoding: 'utf-8', success: (data : any) => { if (epoch !== generation) return; importText.value = String(data.data); importPreview.value = null }, fail: () => { if (epoch === generation) error.value = '无法读取备份文件，请检查权限或粘贴完整内容' } }) }, fail: () => { if (epoch === generation) error.value = '未选择备份文件' } })

	}
	function checkBackup() { if (busy.value) return; busy.value = true; const epoch = generation; setTimeout(async () => { if (epoch !== generation) return; try { const preview = await vault.inspectBackupAsync(importText.value, backupPassword.value); if (epoch !== generation) return; importPreview.value = preview; error.value = '' } catch (e) { if (epoch === generation) { importPreview.value = null; error.value = message(e) } } finally { if (epoch === generation) busy.value = false } }, 40) }
	function confirmRestore() { if (!importPreview.value) return; openSheet('restore-confirm', '确认恢复备份？', space.value ? (restoreMode.value === 'replace' ? '当前空间的数据将被替换，恢复前会保存加密快照。' : '相同 ID 的记录按更新时间合并，其他记录保留。') : '创建新空间并导入备份中的账本和记录。', [{ label: '执行恢复', value: 'confirm', danger: restoreMode.value === 'replace' }]) }
	async function performRestore() { if (busy.value) return; busy.value = true; const epoch = generation; try { const source = validateSpace(importPreview.value); if (space.value) { vault.snapshot(space.value); const target = restoreMode.value === 'merge' ? mergeSpace(space.value, source) : Object.assign(source, { id: space.value.id, name: space.value.name, private: space.value.private }); vault.persist(target); space.value = target } else { const restored = await vault.registerAsync(source.name, source.private, restorePin.value, source); if (epoch !== generation) { vault.lock(); return } space.value = restored } importPreview.value = null; importText.value = ''; backupPassword.value = ''; restorePin.value = ''; routeSpace(); toast('数据已恢复') } catch (e) { if (epoch === generation) error.value = message(e) } finally { if (epoch === generation) busy.value = false } }
	function openRollback() { openSheet('rollback', '回滚到恢复前', '输入当前密码，验证恢复前的加密快照。', []) }
	function migrateLegacy() { openSheet('legacy', '导入旧版活动账本', '将每位往来对象的金额转换为一笔收入或支出，新建“旧版活动账本”。原始数据继续保留。', [{ label: '导入旧版数据', value: 'confirm' }]) }
	function doMigrate() { const raw = uni.getStorageSync('nice-tally.ledger.v1'); let count = 0; if (commit(s => { count = migrateLegacyInto(s, typeof raw === 'string' ? raw : JSON.stringify(raw)) })) { toast(count ? '已导入 ' + count + ' 笔旧版记录' : '旧记录已导入，无重复新增') } }
	function openLegacy() { lockNow(); uni.navigateTo({ url: '/pages/tally/index' }) }
	const sheet = ref(''), sheetTitle = ref(''), sheetCopy = ref(''), sheetOptions = ref<{ label : string; value : string; danger ?: boolean }[]>([]), confirmation = ref(''), sheetError = ref('')
	function openSheet(kind : string, title : string, copy : string, options : { label : string; value : string; danger ?: boolean }[]) { sheet.value = kind; sheetTitle.value = title; sheetCopy.value = copy; sheetOptions.value = options; confirmation.value = ''; sheetError.value = '' }
	function closeSheet() { sheet.value = ''; confirmation.value = ''; sheetError.value = '' }
	function chooseSheet(value : string) { const kind = sheet.value; closeSheet(); if (kind === 'help') { go('restore'); return } if (kind === 'archive') { if (commit(s => { currentBook(s, bookId.value).archived = true; if (s.defaultBookId === bookId.value) s.defaultBookId = '' })) toast('账本已归档'); return } if (kind === 'copy-book') { let copied = ''; if (commit(s => copied = duplicateBook(s, bookId.value, value).id)) { bookId.value = copied; page.value = 'home'; toast('账本已复制') } return } if (kind === 'delete-first') { openSheet('delete-book', '永久删除账本', '请输入完整账本名称：' + book.value?.name, []); return } if (kind === 'delete-record' && selected.value) { const t = clone(selected.value); if (commit(s => s.transactions = s.transactions.filter(v => v.id !== t.id))) { page.value = 'records'; toast('记录已删除'); undoTransaction.value = t } return } if (kind === 'record-actions') { if (value === 'edit') editRecord(selected.value!); if (value === 'copy') copyRecord(); if (value === 'delete') deleteRecord(); return } if (kind === 'delete-field') { if (commit(s => { const f = currentBook(s, bookId.value).fields.find(f => f.id === fieldForm.value.id)!; f.deleted = true; f.enabled = false })) { page.value = 'fields'; toast('字段已删除，历史值保留') } return } if (kind === 'leave-entry') { if (value === 'draft') submitEntry(true); else { amount.value = ''; page.value = history.value.pop() || 'home' } return } if (kind === 'restore-confirm') { performRestore(); return } if (kind === 'legacy') doMigrate() }
	async function confirmDanger() { if (sheet.value === 'delete-book') { if (commit(s => removeBook(s, bookId.value, confirmation.value))) { closeSheet(); routeSpace(); toast('账本已永久删除') } else sheetError.value = error.value } else if (sheet.value === 'rollback') { if (busy.value) return; busy.value = true; try { const s = await vault.restoreSnapshotAsync(confirmation.value); vault.persist(s); space.value = s; closeSheet(); routeSpace(); toast('已回滚到恢复前') } catch (e) { sheetError.value = message(e) } finally { busy.value = false } } }
	function measure() { const w = uni.getWindowInfo(); viewportWidth = w.windowWidth; topInset.value = w.statusBarHeight || 0; bottomInset.value = w.safeAreaInsets?.bottom || 0; wide.value = w.windowWidth >= 900 }
	onMounted(() => {

		measure(); initialize(); uni.$on('xiaojin-lock', lockNow); tick = setInterval(() => { if (page.value === 'lock') lockSeconds.value = vault.remaining() }, 1000);

		protectScreen()





	})
	onBackPress(() : boolean => requestBack())
	function visibility() {



	}
	onShow(() => { if (page.value === 'lock') lockSeconds.value = vault.remaining() })
	onResize(measure)
	onUnmounted(() => {

		clearInterval(tick); clearTimeout(pinTimer); clearTimeout(toastTimer); uni.$off('xiaojin-lock', lockNow);



	})
</script>

