<template>
	<view class="xj-app" :style="{ backgroundColor: '#F4F7FC' }" @touchstart="edgeBackStart"
		@touchmove="edgeBackMove" @touchend="edgeBackEnd" @touchcancel="edgeBackCancel">
		<view class="safe-top" :style="{ height: topInset + 'px' }" />
		<view v-if="page == 'welcome'" class="welcome-page">
			<image class="launch-background" src="/static/xiaojin/launch-landscape-v2.png" mode="aspectFill" />
			<view class="launch-content">
				<view class="welcome-top"><xj-asset name="logo" :size="72" tint="#FFF1F5" /><text class="brand">小金账</text><text
						class="welcome-line">记录好每一笔美好生活</text></view>
				<view class="launch-spacer" />
				<view class="launch-copy"><text class="launch-script">简单的记账</text><text class="launch-script">更好的生活 ♡</text></view>
				<view class="launch-features">
					<view class="launch-feature"><xj-asset name="home" :size="29" tint="#DAE9FF" /><text class="launch-feature-text">完全离线 · 本地存储</text></view>
					<view class="launch-feature"><xj-asset name="lock" :size="29" tint="#FFE0E9" /><text class="launch-feature-text">多账本 · 不同密码</text></view>
					<view class="launch-feature"><xj-asset name="record" :size="29" tint="#EDE4FF" /><text class="launch-feature-text">自定义字段 · 灵活扩展</text></view>
					<view class="launch-feature"><xj-asset name="chart" :size="29" tint="#DDF6F2" /><text class="launch-feature-text">丰富统计 · 多维分析</text></view>
					<view class="launch-feature"><xj-asset name="coin" :size="29" tint="#FFF0D9" /><text class="launch-feature-text">个性主题 · 随心切换</text></view>
					<view class="launch-feature"><xj-asset name="shield" :size="29" tint="#FFE0F2" /><text class="launch-feature-text">隐私安全 · 数据只属于你</text></view>
				</view>
				<button class="primary-btn launch-button" :style="accentBg" @click="beginSpace(false)">开始使用</button>
				<text class="text-action centered launch-restore" :style="accentText" @click="go('restore')">从本地备份恢复</text>
			</view>
		</view>

		<view v-else-if="page == 'lock' || page == 'pin-setup'" class="auth-page">
			<view class="auth-nav"><text v-if="page == 'pin-setup'" class="text-action"
					@click="cancelSetup">取消</text><text v-else class="app-wordmark">小金账</text></view>
			<view class="auth-heading"><xj-asset name="lock" :size="62" tint="#F1F3F7" /><text
					class="hero-title">{{ page == 'pin-setup' ? (firstPin ? '再次输入密码' : '设置解锁密码') : '欢迎回来' }}</text><text
					class="body-copy centered">{{ page == 'pin-setup' ? '请设置 6 位数字密码' : '请输入密码' }}</text></view>
			<view class="pin-dots">
				<view v-for="n in 6" :key="n" class="pin-dot"
					:style="{ backgroundColor: pin.length >= n ? accent : '#DFE4ED' }" />
			</view>
			<view class="auth-message"><text v-if="busy" class="secondary">正在安全处理…</text><text
					v-else-if="lockSeconds > 0" class="error-text">尝试次数过多，请在 {{ countdown }} 后重试</text><text
					v-else-if="error" class="error-text">{{ error }}</text></view>
			<view class="keypad">
				<view v-for="key in keys" :key="key" class="key-slot">
					<view v-if="key" class="number-key" @click="pressPin(key)"><text
							class="number-key-text">{{ key == 'delete' ? '⌫' : key }}</text></view>
				</view>
			</view>
			<text v-if="page == 'lock'" class="text-action centered" @click="helpUnlock">无法解锁？</text>
			<text v-else class="auth-warning">密码只用于本机解锁，不会上传。请妥善保存，忘记密码后无法通过服务器找回。</text>
			<text class="footnote">完全离线 · 你的记录，由你掌控</text>
		</view>

		<template v-else>
			<view class="workspace">
				<view v-if="wide && space" class="side-nav"><text class="brand-small">小金账</text><text
						class="secondary side-caption">记录生活，规划未来</text>
					<view v-for="tab in tabs" :key="tab.page" class="side-item"
						:style="{ backgroundColor: page == tab.page ? accentSoft : 'transparent' }"
						@click="switchTab(tab.page)"><text class="row-title"
							:style="page == tab.page ? accentText : {}">{{ tab.name }}</text></view>
					<view class="side-item" @click="lockNow"><text class="secondary">锁定并退出</text></view>
				</view>
				<view class="main-panel">
					<view v-if="!isTab" class="toolbar">
						<text class="back-action" :style="accentText" @click="back">‹ 返回</text>
						<text class="toolbar-title">{{ title }}</text>
						<view class="toolbar-spacer" />
					</view>
					<scroll-view class="page-scroll">
						<view class="page-content" :class="'screen-' + page">
							<view v-if="error && page != 'fault'" class="error-box"><text
									class="error-text">{{ error }}</text></view>

							<template v-if="page == 'fault'">
								<view class="empty-state"><xj-asset name="shield" :size="72" /><text
										class="section-title">无法读取本地数据</text><text
										class="body-copy centered">{{ error }}</text><button class="primary-btn"
										:style="accentBg" @click="initialize">重试</button><text class="text-action"
										@click="go('restore')">从备份恢复</text><text class="footnote">原始数据仍保留在本机</text>
								</view>
							</template>

							<template v-if="page == 'space-new'">
								<view class="page-intro"><xj-asset name="shield" :size="60" /><text
										class="hero-title">{{ privateDraft ? '创建隐私空间' : '创建你的数据空间' }}</text><text
										class="body-copy">一个空间可以包含多个账本。不同空间使用不同密码解锁。</text></view>
								<text class="group-label">空间名称</text>
								<view class="surface"><input v-model="spaceName" class="form-input" placeholder="我的空间"
										:maxlength="20" /></view>
								<text class="group-label">空间类型</text>
								<view class="surface">
									<view class="setting-row" @click="privateDraft = false">
										<view class="grow"><text class="row-title">普通空间</text><text
												class="row-caption">日常生活，轻松管理</text></view><text
											:style="accentText">{{ !privateDraft ? '●' : '○' }}</text>
									</view>
									<view class="setting-row" @click="privateDraft = true">
										<view class="grow"><text class="row-title">隐私空间</text><text
												class="row-caption">独立密码，其他空间不可见</text></view><text
											:style="accentText">{{ privateDraft ? '●' : '○' }}</text>
									</view>
								</view>
								<view v-if="privateDraft" class="notice"><text class="notice-title">只属于这个空间</text><text
										class="body-copy">不显示在普通空间，不参与其他空间统计。退出后需要重新输入密码，进入后台立即锁定。</text></view>
								<button class="primary-btn" :style="accentBg" @click="startPinSetup">设置空间密码</button>
							</template>

							<template v-if="page == 'home' && book && space">
								<view class="home-heading home-prototype-heading">
									<view class="grow"><text class="eyebrow">{{ todayLabel }}</text><text
											class="home-greeting">今天也是美好的一天！</text><text class="home-book" @click="go('books')">{{ book.name }} ⌄</text></view>
									<view class="round-control" @click="go('records')"><text class="control-text"
											:style="accentText">⌕</text></view>
								</view>
								<view class="balance-card home-balance-card"><text class="secondary">{{ periodLabel }}收支</text><text
										class="balance-number" :style="accentText">{{ book.currency }}
										{{ money(totals.net) }}</text>
									<view class="money-row">
										<view class="grow"><text class="muted-label">收入</text><text
												class="money-value">{{ book.currency }}
												{{ money(totals.income) }}</text></view>
										<view class="grow"><text class="muted-label">支出</text><text
												class="money-value">{{ book.currency }}
												{{ money(totals.expense) }}</text></view>
									</view>
									<view class="card-divider" />
									<view class="between"><text class="row-caption">本月 {{ totals.count }}
											笔记录</text><text class="small-link" :style="accentText"
											@click="go('stats')">查看统计 ›</text></view>
								</view>
								<view class="quick-row home-shortcuts">
									<view v-for="item in shortcuts" :key="item.page" class="quick-item"
										@click="quick(item.page)"><xj-asset :name="item.icon" :size="44"
											tint="#F4F5F8" /><text class="quick-label">{{ item.name }}</text></view>
								</view>
								<view v-if="drafts.length" class="notice inline-notice" @click="editRecord(drafts[0])">
									<text class="small-link" :style="accentText">{{ drafts.length }} 条草稿待完成</text><text
										class="secondary">继续填写 ›</text>
								</view>
								<view class="section-heading"><text class="section-title">最近记录</text><text
										class="small-link" @click="go('records')">查看全部 ›</text></view>
								<view v-if="recent.length" class="surface">
									<view v-for="t in recent" :key="t.id" class="transaction-row"
										@click="showRecord(t)"><xj-asset :name="entityIcon(t)" :size="40"
											:tint="t.kind == 'income' ? '#E9F7F1' : '#FFF1ED'" />
										<view class="transaction-copy"><text
												class="row-title">{{ recordTitle(book,t) }}</text><text
												class="row-caption">{{ t.date }} ·
												{{ t.note || label(book,t.objectId) }}</text></view><text
											class="amount-small"
											:style="{color:t.kind == 'income' ? '#32A78F' : '#24324A'}">{{ t.kind == 'income' ? '+' : t.kind == 'expense' ? '−' : '' }}{{ money(t.cents) }}</text>
									</view>
								</view>
								<view v-else class="empty-state surface"><xj-asset name="empty" :size="60"
										tint="#F4F5F8" /><text class="section-title">从第一笔开始</text><text
										class="body-copy centered">一杯咖啡，一次出行，都值得被记下。</text><button class="soft-btn"
										:style="accentText" @click="openEntry()">记一笔</button></view>
								<text class="footnote">完全离线 · 本地加密存储</text>
							</template>

							<template v-if="page == 'books' && space">
								<view class="section-heading"><text class="page-title">我的账本</text><text
										class="add-action" :style="accentText" @click="newBook">＋</text></view>
								<view class="segment">
									<view class="segment-item" :style="!showArchived ? selectedSegment : {}"
										@click="showArchived = false"><text class="segment-text">使用中</text></view>
									<view class="segment-item" :style="showArchived ? selectedSegment : {}"
										@click="showArchived = true"><text class="segment-text">已归档</text></view>
								</view>
								<view v-for="b in visibleBooks" :key="b.id" class="book-card" @click="selectBook(b)">
									<xj-asset :name="b.icon" :size="50"
										:tint="b.id == bookId ? accentSoft : '#F2F5F8'" />
									<view class="book-copy">
										<view class="row"><text class="section-title">{{ b.name }}</text><text
												v-if="space.defaultBookId == b.id" class="badge"
												:style="accentText">默认</text></view><text
											class="row-caption">{{ b.type }} · {{ bookCount(b.id) }} 笔记录</text><text
											class="row-caption">本月支出 {{ b.currency }}
											{{ money(bookExpense(b.id)) }}</text>
									</view><text class="chevron">›</text>
								</view>
								<view v-if="!visibleBooks.length" class="empty-state"><xj-asset name="book"
										:size="64" /><text
										class="section-title">{{ showArchived ? '暂无归档账本' : '还没有账本' }}</text><text
										class="body-copy centered">{{ showArchived ? '归档后记录仍然保留，可随时恢复。' : '创建一个账本，开始记录生活。' }}</text>
								</view>
								<button v-if="!showArchived" class="outline-btn" :style="accentText" @click="newBook">＋
									创建账本</button>
								<text v-if="book" class="text-action centered" @click="manageBook(book)">管理当前账本</text>
							</template>

							<template v-if="page == 'book-new' || page == 'book-edit'">
								<view class="book-preview"><xj-asset :name="bookForm.icon" :size="62" /><text
										class="section-title">{{ bookForm.name || '你的新账本' }}</text><text
										class="row-caption">{{ bookForm.type }} · {{ bookForm.currency }}</text></view>
								<text class="group-label">账本名称 *</text>
								<view class="surface"><input v-model="bookForm.name" class="form-input"
										placeholder="例如：日常账本" :maxlength="20" /></view>
								<text class="group-label">账本图标</text>
								<view class="surface icon-options">
									<view v-for="(name,i) in bookIcons" :key="name" class="icon-option"
										:style="{borderColor:bookForm.icon == name ? accent : '#FFFFFF'}"
										@click="bookForm.icon = name"><xj-asset :name="name" :size="38"
											tint="#F2F4F7" /><text class="tiny">{{ bookIconLabels[i] }}</text></view>
								</view>
								<text class="group-label">主题色</text>
								<view class="surface color-row">
									<view v-for="c in themes" :key="c.color" class="swatch-wrap"
										@click="bookForm.color = c.color">
										<view class="swatch" :style="{backgroundColor:c.color}"><text
												class="swatch-check">{{ bookForm.color == c.color ? '✓' : '' }}</text>
										</view><text class="tiny">{{ c.name }}</text>
									</view>
								</view>
								<view class="surface">
									<picker :range="bookTypes" @change="bookForm.type = bookTypes[$event.detail.value]">
										<view class="setting-row"><text class="row-title grow">账本类型</text><text
												class="secondary">{{ bookForm.type }} ›</text></view>
									</picker>
									<picker :range="currencies"
										@change="bookForm.currency = currencies[$event.detail.value]">
										<view class="setting-row"><text class="row-title grow">默认币种</text><text
												class="secondary">{{ bookForm.currency }} ›</text></view>
									</picker>
								</view>
								<text class="body-copy">类型用于选择默认配置；账本属于当前解锁空间。</text>
								<button class="primary-btn" :style="accentBg" :disabled="busy"
									@click="submitBook">{{ busy ? '正在保存…' : page == 'book-edit' ? '保存修改' : '创建账本' }}</button>
							</template>

							<template v-if="page == 'book-manage' && book">
								<view class="book-preview"><xj-asset :name="book.icon" :size="62" /><text
										class="page-title">{{ book.name }}</text><text
										class="secondary">{{ bookCount(book.id) }} 笔记录 · {{ book.fields.length }}
										个自定义字段</text></view>
								<view class="surface">
									<view class="setting-row" @click="editBook"><text
											class="row-title grow">名称、图标与主题</text><text class="chevron">›</text></view>
									<view class="setting-row" @click="defaultBook"><text
											class="row-title grow">设为默认账本</text><text
											class="secondary">{{ space && space.defaultBookId == book.id ? '已设为默认' : '›' }}</text>
									</view>
									<view class="setting-row" @click="openCopy"><text
											class="row-title grow">复制账本</text><text class="chevron">›</text></view>
								</view>
								<view class="surface">
									<view class="setting-row" @click="openCatalog('expense')"><text
											class="row-title grow">分类管理</text><text class="chevron">›</text></view>
									<view class="setting-row" @click="openCatalog('object')"><text
											class="row-title grow">往来对象</text><text class="chevron">›</text></view>
									<view class="setting-row" @click="openCatalog('account')"><text
											class="row-title grow">支付账户</text><text class="chevron">›</text></view>
									<view class="setting-row" @click="go('fields')"><text
											class="row-title grow">自定义字段</text><text
											class="secondary">{{ book.fields.filter(f => !f.deleted).length }} 个
											›</text></view>
								</view>
								<view class="surface">
									<view class="setting-row" @click="archiveBook"><text
											class="row-title grow">{{ book.archived ? '恢复账本' : '归档账本' }}</text><text
											class="chevron">›</text></view>
									<view class="setting-row" @click="deleteBook"><text
											class="danger grow">删除账本</text><text class="chevron">›</text></view>
								</view>
								<text class="body-copy">归档会保留历史记录和统计；删除账本将永久移除其中的数据。</text>
							</template>

							<template v-if="page == 'records' && book">
								<text class="page-title">记录</text>
								<view class="records-calendar"><view class="calendar-month-row"><text class="section-title">{{ period }} 月度记录</text><text class="small-link" :style="accentText" @click="recordDay=''">全部</text></view><view class="calendar-week-row"><text v-for="name in calendarWeekdays" :key="name" class="calendar-weekday">{{ name }}</text></view><view class="calendar-days"><view v-for="(day,index) in recordCalendarCells" :key="index" class="calendar-day-slot"><view v-if="day" class="calendar-day" :style="recordDay==recordDateKey(day)?accentBg:{}" @click="recordDay=recordDay==recordDateKey(day)?'':recordDateKey(day)"><text class="calendar-day-text" :style="recordDay==recordDateKey(day)?{color:'#FFFFFF'}:{}">{{ day }}</text></view></view></view></view>
								<view class="search-surface"><input v-model="search" class="form-input"
										placeholder="搜索备注、分类、对象或自定义字段" /></view>
								<view class="filter-row">
									<picker mode="date" fields="month" :value="period + '-01'"
										@change="period = $event.detail.value.slice(0,7)"><text
											class="filter-chip">{{ period }} ⌄</text></picker>
									<picker :range="kindLabels" @change="kindFilter = kindOptions[$event.detail.value]">
										<text class="filter-chip">{{ kindLabels[kindOptions.indexOf(kindFilter)] }}
											⌄</text>
									</picker><text class="filter-chip" @click="advancedFilters = !advancedFilters">筛选
										{{ advancedFilters ? '−' : '＋' }}</text>
								</view>
								<view v-if="advancedFilters" class="surface filter-panel"><text
										class="group-label">金额范围</text>
									<view class="row"><input v-model="minAmount" class="compact-input grow" type="digit"
											placeholder="最低金额" /><text class="secondary">—</text><input
											v-model="maxAmount" class="compact-input grow" type="digit"
											placeholder="最高金额" /></view>
									<picker
										:range="['所有分类', ...book.entities.filter(e => ['expense','income'].includes(e.kind)).map(e=>e.name)]"
										@change="categoryFilter = Number($event.detail.value) == 0 ? '' : book.entities.filter(e=>['expense','income'].includes(e.kind))[$event.detail.value-1].id">
										<view class="setting-row"><text class="row-title grow">分类</text><text
												class="secondary">{{ categoryFilter ? label(book,categoryFilter) : '全部' }}
												›</text></view>
									</picker>
									<view v-for="f in book.fields.filter(f=>f.filterable && !f.deleted)" :key="f.id">
										<text class="group-label">{{ f.name }}</text><input v-model="fieldFilters[f.id]"
											class="compact-input" placeholder="输入匹配内容" />
									</view><text class="text-action" :style="accentText"
										@click="clearFilters">重置筛选</text>
								</view>
								<view class="section-heading"><text class="secondary">{{ filtered.length }}
										笔记录</text><text class="small-link" :style="accentText" @click="openEntry()">＋
										记一笔</text></view>
								<view v-if="filtered.length" class="surface">
									<view v-for="t in filtered" :key="t.id" class="transaction-row"
										@click="showRecord(t)" @longpress="recordActions(t)"><xj-asset
											:name="entityIcon(t)" :size="38" tint="#F2F5F8" />
										<view class="transaction-copy"><text
												class="row-title">{{ recordTitle(book,t) }}</text><text
												class="row-caption">{{ t.date }} ·
												{{ t.note || label(book,t.objectId) }}</text></view><text
											class="amount-small"
											:style="{color:t.kind=='income'?'#32A78F':'#24324A'}">{{ t.kind=='income'?'+':t.kind=='expense'?'−':'' }}{{ money(t.cents) }}</text>
									</view>
								</view>
								<view v-else class="empty-state"><xj-asset name="empty" :size="64" /><text
										class="section-title">没有找到记录</text><text
										class="body-copy centered">试试其他关键词，或调整筛选条件。</text><text class="text-action"
										:style="accentText" @click="clearFilters">清除筛选</text></view>
							</template>

							<template v-if="page == 'entry' && book">
								<view class="segment">
									<view v-for="(k,i) in transactionKinds" :key="k" class="segment-item"
										:style="entry.kind==k ? {backgroundColor:accent} : {}" @click="changeKind(k)">
										<text class="segment-text"
											:style="{color:entry.kind==k?'#FFFFFF':'#8590A2'}">{{ transactionLabels[i] }}</text>
									</view>
								</view>
								<view class="amount-entry"><text class="amount-currency"
										:style="accentText">{{ book.currency }}</text><input v-model="amount"
										class="amount-field" type="digit" placeholder="0.00" :maxlength="11" /></view>
								<view v-if="entry.kind != 'transfer'" class="category-grid">
									<view v-for="e in entryCategories" :key="e.id" class="category-item"
										:style="{backgroundColor:entry.categoryId==e.id?accentSoft:'transparent'}"
										@click="entry.categoryId = e.id"><xj-asset :name="e.icon" :size="40"
											:tint="entry.categoryId==e.id?accentSoft:'#F0F3F7'" /><text
											class="category-name"
											:style="entry.categoryId==e.id?accentText:{}">{{ e.name }}</text></view>
								</view>
								<view class="entry-keypad">
									<view v-for="key in amountKeys" :key="key" class="entry-key-slot">
										<view v-if="key" class="entry-key" :class="key=='delete'?'entry-key-delete':''" @click="pressAmountKey(key)"><text
												class="entry-key-text">{{ key=='delete'?'⌫':key }}</text></view>
									</view>
								</view>
								<view class="surface">
									<picker mode="date" :value="entry.date" @change="entry.date = $event.detail.value">
										<view class="setting-row"><text class="row-title grow">日期</text><text
												class="secondary">{{ entry.date }} ›</text></view>
									</picker>
									<picker :range="accountOptions.map(e=>e.name)"
										@change="entry.accountId = accountOptions[$event.detail.value].id">
										<view class="setting-row"><text
												class="row-title grow">{{ entry.kind=='transfer'?'转出账户':'支付方式' }}</text><text
												class="secondary">{{ label(book,entry.accountId) }} ›</text></view>
									</picker>
									<picker v-if="entry.kind=='transfer'" :range="accountOptions.map(e=>e.name)"
										@change="entry.toAccountId = accountOptions[$event.detail.value].id">
										<view class="setting-row"><text class="row-title grow">转入账户</text><text
												class="secondary">{{ label(book,entry.toAccountId) }} ›</text></view>
									</picker>
									<picker :range="objectOptions.map(e=>e.name)"
										@change="entry.objectId = objectOptions[$event.detail.value].id">
										<view class="setting-row"><text class="row-title grow">往来对象</text><text
												class="secondary">{{ label(book,entry.objectId) }} ›</text></view>
									</picker>
									<view class="setting-row"><text class="row-title">备注</text><input
											v-model="entry.note" class="inline-input" placeholder="点击输入备注"
											:maxlength="300" /></view>
								</view>
								<text v-if="entry.kind=='transfer'" class="body-copy">转账只改变账户间的往来，不计入收入和支出。</text>
								<view class="section-heading" @click="moreFields = !moreFields"><text
										class="section-title">更多字段</text><text class="small-link"
										:style="accentText">{{ moreFields ? '收起 −' : '展开 ＋' }}</text></view>
								<view v-if="moreFields" class="surface field-values">
									<view v-for="f in visibleFields" :key="f.id" class="dynamic-field"><text
											class="field-label">{{ f.name }}{{ f.required?' *':'' }}</text>
										<picker v-if="f.type=='单选' || f.type=='对象引用'" :range="optionsFor(f)"
											@change="entry.values[f.id] = optionsFor(f)[$event.detail.value]">
											<view class="field-select"><text
													class="secondary">{{ entry.values[f.id] || '请选择' }} ›</text></view>
										</picker>
										<view v-else-if="f.type=='多选'" class="chips-wrap"><text v-for="o in f.options"
												:key="o" class="filter-chip" :style="multiSelected(f,o)?accentText:{}"
												@click="toggleMulti(f,o)">{{ multiSelected(f,o)?'✓ ':'' }}{{ o }}</text>
										</view>
										<switch v-else-if="f.type=='开关'" :checked="entry.values[f.id]=='是'"
											:color="accent"
											@change="entry.values[f.id] = $event.detail.value ? '是' : '否'" />
										<picker v-else-if="f.type=='日期'" mode="date"
											@change="entry.values[f.id] = $event.detail.value"><text
												class="field-select secondary">{{ entry.values[f.id] || '选择日期' }}
												›</text></picker>
										<view v-else-if="f.type=='星级'" class="row"><text v-for="n in 5" :key="n"
												class="star"
												:style="{color:Number(entry.values[f.id]||0)>=n?accent:'#DCE1EA'}"
												@click="entry.values[f.id] = String(n)">★</text></view>
										<view v-else-if="f.type=='图片' || f.type=='文件'"><text class="text-action"
												:style="accentText" @click="chooseAttachment(f)">＋
												添加{{ f.type }}</text><text v-if="entry.values[f.id]" class="body-copy"
												@click="previewAttachment(f)">{{ attachmentLabel(entry.values[f.id]) }}</text><text
												v-if="entry.values[f.id]" class="danger small-link"
												@click="entry.values[f.id] = ''">移除附件</text></view>
										<input v-else v-model="entry.values[f.id]"
											:type="['数字','金额'].includes(f.type)?'digit':'text'" class="compact-input"
											:placeholder="f.type=='日期时间'?'YYYY-MM-DD HH:mm':'请输入'+f.name" />
									</view>
									<text v-if="!visibleFields.length" class="body-copy">当前条件下没有需要填写的扩展字段。</text><text
										class="text-action" :style="accentText" @click="go('fields')">＋ 配置自定义字段</text>
								</view>
								<view v-if="saveError" class="error-box"><text class="error-text">{{ saveError }}</text>
								</view>
								<button class="primary-btn" :style="accentBg" :disabled="busy"
									@click="submitEntry(false)">{{ busy?'正在保存…':'保存记录' }}</button>
								<view class="between"><text class="text-action" :style="accentText"
										@click="submitEntry(true)">保存草稿</text>
									<view class="row"><text class="secondary">保存后继续</text>
										<switch :checked="keepEntering" :color="accent"
											@change="keepEntering = $event.detail.value" />
									</view>
								</view>
							</template>

							<template v-if="page == 'detail' && selected && book">
								<view class="detail-hero"><xj-asset :name="entityIcon(selected)" :size="58" /><text
										class="section-title">{{ recordTitle(book,selected) }}</text><text
										class="detail-amount"
										:style="{color:selected.kind=='income'?'#32A78F':accent}">{{ selected.kind=='income'?'+':selected.kind=='expense'?'−':'' }}{{ book.currency }}
										{{ money(selected.cents) }}</text><text
										class="secondary">{{ selected.draft?'草稿':transactionLabels[transactionKinds.indexOf(selected.kind)] }}</text>
								</view>
								<view class="surface">
									<view v-for="row in detailRows" :key="row.name" class="setting-row"><text
											class="secondary detail-label">{{ row.name }}</text><text
											class="detail-value">{{ row.value }}</text></view>
								</view>
								<view v-if="historicalFields.length" class="surface">
									<view v-for="f in historicalFields" :key="f.id" class="setting-row"><text
											class="secondary detail-label">{{ f.name }}{{ f.deleted?'（已删除）':!f.enabled?'（已停用）':'' }}</text><text
											class="detail-value"
											@click="previewStoredAttachment(f,selected.values[f.id])">{{ ['图片','文件'].includes(f.type)?attachmentLabel(selected.values[f.id]):selected.values[f.id] }}</text>
									</view>
								</view>
								<text class="footnote">创建于 {{ new Date(selected.createdAt).toLocaleString() }}</text>
								<view class="actions-row"><button class="soft-btn grow action-secondary"
										@click="copyRecord">复制</button><button class="primary-btn grow action-primary"
										:style="accentBg" @click="editRecord(selected)">编辑</button></view><text
									class="text-action centered danger" @click="deleteRecord">删除记录</text>
							</template>

							<template v-if="page == 'fields' && book">
								<text class="page-title">字段配置</text><text class="body-copy">让每一笔记录，都有自己的细节。</text>
								<text class="group-label">基础字段 · 系统内置</text>
								<view class="surface">
									<view v-for="name in ['金额','收支类型','分类','往来对象','日期','支付方式','备注']" :key="name"
										class="setting-row"><text class="row-title grow">{{ name }}</text><text
											class="row-caption">不可删除</text></view>
								</view>
								<view class="section-heading"><text class="section-title">自定义字段</text><text
										class="row-caption">当前账本</text></view>
								<view class="surface">
									<view v-for="f in book.fields.filter(f=>!f.deleted).sort((a,b)=>a.order-b.order)"
										:key="f.id" class="setting-row">
										<view class="grow" @click="editField(f)"><text
												class="row-title">{{ f.name }}</text><text
												class="row-caption">{{ f.type }}{{ f.required?' · 必填':'' }}{{ f.enabled?'':' · 已停用' }}{{ f.conditionField?' · 条件显示':'' }}</text>
										</view><text class="move-action" @click="moveField(f,-1)">↑</text><text
											class="move-action" @click="moveField(f,1)">↓</text><text class="chevron"
											@click="editField(f)">›</text>
									</view>
								</view>
								<button class="primary-btn" :style="accentBg" @click="newField">＋ 添加自定义字段</button><text
									class="body-copy">停用或删除字段会保留历史值。已有记录使用的字段类型不可直接修改。</text>
							</template>

							<template v-if="page == 'field-edit' && book">
								<text class="group-label">字段名称 *</text>
								<view class="surface"><input v-model="fieldForm.name" class="form-input"
										placeholder="例如：是否报销、参与人、项目" :maxlength="24" /></view>
								<view class="surface">
									<picker :range="fieldTypes" @change="setFieldType($event.detail.value)">
										<view class="setting-row"><text class="row-title grow">字段类型</text><text
												class="secondary">{{ fieldForm.type }} ›</text></view>
									</picker>
								</view>
								<template v-if="['单选','多选'].includes(fieldForm.type)"><text class="group-label">选项 ·
										每行一项</text><textarea v-model="fieldOptionsText" class="text-area"
										placeholder="现金&#10;微信&#10;银行卡" /></template>
								<text class="group-label">默认值</text>
								<view class="surface"><input v-model="fieldForm.defaultValue" class="form-input"
										placeholder="不设置默认值" /></view>
								<view class="surface">
									<view class="setting-row"><text class="row-title grow">必填</text>
										<switch :checked="fieldForm.required" :color="accent"
											@change="fieldForm.required=$event.detail.value" />
									</view>
									<view class="setting-row"><text class="row-title grow">启用字段</text>
										<switch :checked="fieldForm.enabled" :color="accent"
											@change="fieldForm.enabled=$event.detail.value" />
									</view>
									<view class="setting-row"><text class="row-title grow">参与搜索</text>
										<switch :checked="fieldForm.searchable" :color="accent"
											@change="fieldForm.searchable=$event.detail.value" />
									</view>
									<view class="setting-row"><text class="row-title grow">参与筛选</text>
										<switch :checked="fieldForm.filterable" :color="accent"
											@change="fieldForm.filterable=$event.detail.value" />
									</view>
									<view class="setting-row"><text class="row-title grow">参与统计分组</text>
										<switch :checked="fieldForm.statistical" :color="accent"
											@change="fieldForm.statistical=$event.detail.value" />
									</view>
								</view>
								<text class="group-label">适用收支类型 · 不选则全部适用</text>
								<view class="chips-wrap"><text v-for="(k,i) in transactionKinds" :key="k"
										class="filter-chip" :style="fieldForm.kinds.includes(k)?accentText:{}"
										@click="toggleFieldKind(k)">{{ fieldForm.kinds.includes(k)?'✓ ':'' }}{{ transactionLabels[i] }}</text>
								</view>
								<text class="group-label">适用分类</text>
								<picker
									:range="['全部分类',...book.entities.filter(e=>['expense','income'].includes(e.kind)).map(e=>e.name)]"
									@change="fieldForm.categoryId=Number($event.detail.value)==0?'':book.entities.filter(e=>['expense','income'].includes(e.kind))[$event.detail.value-1].id">
									<view class="surface setting-row"><text
											class="row-title grow">{{ fieldForm.categoryId?label(book,fieldForm.categoryId):'全部分类' }}</text><text
											class="chevron">›</text></view>
								</picker>
								<text class="group-label">条件显示</text>
								<view class="surface">
									<picker :range="conditionOptions.map(o=>o.name)"
										@change="fieldForm.conditionField=conditionOptions[$event.detail.value].id">
										<view class="setting-row"><text class="row-title grow">当以下字段等于</text><text
												class="secondary">{{ conditionOptions.find(o=>o.id==fieldForm.conditionField)?.name || '始终显示' }}
												›</text></view>
									</picker>
									<picker v-if="['category','account'].includes(fieldForm.conditionField)"
										:range="conditionValueOptions.map(e=>e.name)"
										@change="fieldForm.conditionValue=conditionValueOptions[$event.detail.value].id">
										<view class="setting-row"><text class="row-title grow">匹配值</text><text
												class="secondary">{{ label(book,fieldForm.conditionValue) }} ›</text>
										</view>
									</picker><input v-else-if="fieldForm.conditionField"
										v-model="fieldForm.conditionValue" class="form-input" placeholder="例如：是" />
								</view>
								<text class="body-copy">只有条件成立时显示和校验必填；条件隐藏不会删除已存历史值。条件仅可引用排序在前的字段，避免循环依赖。</text>
								<button class="primary-btn" :style="accentBg" @click="submitField">保存字段</button><text
									v-if="editingField" class="danger text-action centered"
									@click="deleteField">删除字段，保留历史值</text>
							</template>

							<template v-if="page == 'catalog' && book">
								<view class="section-heading"><text
										class="page-title">{{ catalogKind=='object'?'往来对象':catalogKind=='account'?'支付账户':'分类管理' }}</text><text
										class="add-action" :style="accentText" @click="newEntity">＋</text></view>
								<view v-if="['expense','income'].includes(catalogKind)" class="segment">
									<view class="segment-item" :style="catalogKind=='expense'?selectedSegment:{}"
										@click="catalogKind='expense'"><text class="segment-text">支出</text></view>
									<view class="segment-item" :style="catalogKind=='income'?selectedSegment:{}"
										@click="catalogKind='income'"><text class="segment-text">收入</text></view>
								</view>
								<view class="search-surface"><input v-model="entitySearch" class="form-input"
										placeholder="搜索名称" /></view>
								<view class="surface">
									<view v-for="e in catalogEntities" :key="e.id" class="transaction-row"
										@click="showEntity(e)"><xj-asset :name="e.icon" :size="40" tint="#F1F4F8" />
										<view class="transaction-copy"><text class="row-title">{{ e.name }}</text><text
												class="row-caption">{{ e.enabled?'使用中':'已停用' }}{{ e.parentId?' · '+label(book,e.parentId):'' }}</text>
										</view><text class="chevron">›</text>
									</view>
								</view><button class="outline-btn" :style="accentText" @click="newEntity">＋
									添加{{ catalogKind=='object'?'对象':catalogKind=='account'?'账户':'分类' }}</button>
							</template>

							<template v-if="page == 'entity-edit' && book">
								<view class="book-preview"><xj-asset :name="entityForm.icon" :size="58" /><text
										class="section-title">{{ entityForm.name || '新建配置' }}</text></view><text
									class="group-label">名称 *</text>
								<view class="surface"><input v-model="entityForm.name" class="form-input"
										placeholder="请输入名称" :maxlength="24" /></view><text
									class="group-label">图标与颜色</text>
								<view class="surface entity-style-panel"><view class="entity-icon-options"><view v-for="name in bookIcons" :key="name"
										class="entity-icon-option" :style="{backgroundColor:entityForm.icon==name?accentSoft:'#F5F8FC'}" @click="entityForm.icon=name"><xj-asset :name="name" :size="31" tint="#F5F8FC" /></view></view><view class="color-row entity-colors"><view v-for="c in themes" :key="c.color" class="swatch-wrap" @click="entityForm.color=c.color"><view class="swatch" :style="{backgroundColor:c.color}"><text class="swatch-check">{{ entityForm.color==c.color?'✓':'' }}</text></view></view></view></view><text
									class="group-label">备注</text><textarea v-model="entityForm.note"
									class="text-area short-area" placeholder="添加一些说明" />
								<picker v-if="['income','expense'].includes(entityForm.kind)"
									:range="['无上级分类',...parentOptions.map(e=>e.name)]"
									@change="entityForm.parentId=Number($event.detail.value)==0?'':parentOptions[$event.detail.value-1].id">
									<view class="surface setting-row"><text class="row-title grow">上级分类</text><text
											class="secondary">{{ entityForm.parentId?label(book,entityForm.parentId):'无' }}
											›</text></view>
								</picker>
								<view class="surface setting-row"><text class="row-title grow">启用</text>
									<switch :checked="entityForm.enabled" :color="accent"
										@change="entityForm.enabled=$event.detail.value" />
								</view><button class="primary-btn" :style="accentBg"
									@click="submitEntity">保存</button><text
									class="body-copy">停用后不再出现在新记录选择列表，历史记录和统计仍保留。</text>
							</template>

							<template v-if="page == 'entity-detail' && book">
								<view class="book-preview"><xj-asset :name="entityForm.icon" :size="58" /><text
										class="page-title">{{ entityForm.name }}</text><text
										class="body-copy">{{ entityForm.note || '暂无备注' }}</text></view>
								<view class="surface metric-row">
									<view class="grow"><text class="muted-label">累计收入</text><text
											class="money-value">{{ money(entityTotals.income) }}</text></view>
									<view class="grow"><text class="muted-label">累计支出</text><text
											class="money-value">{{ money(entityTotals.expense) }}</text></view>
									<view class="grow"><text class="muted-label">净往来</text><text
											class="money-value">{{ money(entityTotals.net) }}</text></view>
								</view>
								<view class="section-heading"><text class="section-title">关联记录</text><text
										class="secondary">{{ entityRecords.length }} 笔</text></view>
								<view class="surface">
									<view v-for="t in entityRecords" :key="t.id" class="setting-row"
										@click="showRecord(t)">
										<view class="grow"><text class="row-title">{{ recordTitle(book,t) }}</text><text
												class="row-caption">{{ t.date }}</text></view><text
											class="money-value">{{ money(t.cents) }}</text>
									</view>
								</view><button class="primary-btn" :style="accentBg"
									@click="go('entity-edit')">编辑配置</button><text class="text-action centered"
									@click="toggleEntity">{{ entityForm.enabled?'停用':'重新启用' }}</text>
							</template>

							<template v-if="page == 'stats' && book && space">
								<view class="section-heading"><text class="page-title">统计</text><text class="small-link"
										:style="accentText" @click="createReport">＋ 新建方案</text></view>
								<view class="filter-row">
									<picker mode="date" fields="month" :value="period+'-01'"
										@change="period=$event.detail.value.slice(0,7)"><text
											class="filter-chip">{{ period }} ⌄</text></picker><text class="filter-chip"
										@click="statKind=statKind=='expense'?'income':'expense'">{{ statKind=='expense'?'支出':'收入' }}
										⌄</text>
								</view>
								<view class="surface chart-card"><text
										class="secondary">{{ statKind=='expense'?'本月支出':'本月收入' }}</text><text
										class="stats-number" :style="accentText">{{ book.currency }}
										{{ money(statKind=='expense'?totals.expense:totals.income) }}</text><xj-chart
										:groups="defaultGroups" :chart="'donut'" :accent="accent" />
									<view v-for="(g,i) in defaultGroups" :key="g.name" class="legend-row"
										@click="drillInto(g,defaultReport)">
										<view class="legend-dot"
											:style="{backgroundColor:themes[i%themes.length].color}" /><text
											class="row-title grow">{{ g.name }}</text><text
											class="money-value">{{ money(g.value) }}</text><text
											class="chevron">›</text>
									</view><text v-if="!defaultGroups.length"
										class="body-copy centered">记下第一笔，这里就会出现收支分析。</text>
								</view>
								<view class="section-heading"><text class="section-title">我的统计方案</text><text
										class="secondary">{{ book.reports.length }} 个</text></view>
								<view v-for="r in book.reports" :key="r.id" class="surface report-card">
									<view class="between"><text class="section-title"
											@click="viewReport(r)">{{ r.name }}</text><text class="small-link"
											:style="accentText" @click="editReport(r)">编辑</text></view><text
										class="row-caption">{{ chartLabels[chartOptions.indexOf(r.chart)] }} ·
										{{ r.period=='all'?'全部时间':r.period }}</text><text class="text-action"
										:style="accentText" @click="viewReport(r)">查看分析 ›</text>
								</view>
								<button class="outline-btn" :style="accentText" @click="createReport">＋ 创建自定义统计</button>
							</template>

							<template v-if="page == 'report-edit' && space && book">
								<text class="group-label">方案名称 *</text>
								<view class="surface"><input v-model="reportForm.name" class="form-input"
										placeholder="例如：本月餐饮支付方式分析" /></view>
								<text class="group-label">数据范围 · 仅当前空间</text>
								<view class="surface">
									<view v-for="b in space.books" :key="b.id" class="setting-row"
										@click="toggleReportBook(b.id)"><text
											class="row-title grow">{{ b.name }}{{ b.archived?'（已归档）':'' }}</text><text
											:style="accentText">{{ reportForm.bookIds.includes(b.id)?'●':'○' }}</text>
									</view>
								</view>
								<view class="surface">
									<picker :range="kindLabels"
										@change="reportForm.kind=kindOptions[$event.detail.value]">
										<view class="setting-row"><text class="row-title grow">统计对象</text><text
												class="secondary">{{ kindLabels[kindOptions.indexOf(reportForm.kind)] }}
												›</text></view>
									</picker>
									<picker :range="metricLabels"
										@change="reportForm.metric=metricOptions[$event.detail.value]">
										<view class="setting-row"><text class="row-title grow">指标</text><text
												class="secondary">{{ metricLabels[metricOptions.indexOf(reportForm.metric)] }}
												›</text></view>
									</picker>
									<picker :range="dimensions.map(d=>d.name)"
										@change="reportForm.dimension=dimensions[$event.detail.value].id">
										<view class="setting-row"><text class="row-title grow">分析维度</text><text
												class="secondary">{{ dimensions.find(d=>d.id==reportForm.dimension)?.name || '分类' }}
												›</text></view>
									</picker>
									<picker mode="date" fields="month" :value="period+'-01'"
										@change="reportForm.period=$event.detail.value.slice(0,7)">
										<view class="setting-row"><text class="row-title grow">时间范围</text><text
												class="secondary">{{ reportForm.period=='all'?'全部时间':reportForm.period }}
												›</text></view>
									</picker>
									<view class="setting-row" @click="reportForm.period='all'"><text
											class="row-title grow">包含全部时间</text><text
											:style="accentText">{{ reportForm.period=='all'?'✓':'' }}</text></view>
								</view>
								<view class="surface">
									<picker :range="metricFields.map(f=>f.name)"
										@change="reportForm.valueField=metricFields[$event.detail.value].id">
										<view class="setting-row"><text class="row-title grow">统计数值</text><text
												class="secondary">{{ metricFields.find(f=>f.id==(reportForm.valueField||''))?.name || '交易金额' }}
												›</text></view>
									</picker>
									<picker :range="reportCategories.map(e=>e.name)"
										@change="reportForm.categoryId=reportCategories[$event.detail.value].id">
										<view class="setting-row"><text class="row-title grow">限定分类</text><text
												class="secondary">{{ reportCategories.find(e=>e.id==reportForm.categoryId)?.name || '全部分类' }}
												›</text></view>
									</picker>
								</view>
								<text class="group-label">图表类型</text>
								<view class="chips-wrap"><text v-for="(c,i) in chartOptions" :key="c"
										class="filter-chip" :style="reportForm.chart==c?accentText:{}"
										@click="reportForm.chart=c">{{ chartLabels[i] }}</text></view>
								<view class="surface">
									<picker :range="['金额降序','金额升序']"
										@change="reportForm.order=Number($event.detail.value)==0?'desc':'asc'">
										<view class="setting-row"><text class="row-title grow">排序</text><text
												class="secondary">{{ reportForm.order=='desc'?'降序':'升序' }} ›</text>
										</view>
									</picker>
									<picker :range="['前 5 项','前 10 项','全部']"
										@change="reportForm.top=[5,10,1000][$event.detail.value]">
										<view class="setting-row"><text class="row-title grow">显示数量</text><text
												class="secondary">{{ reportForm.top==1000?'全部':'前 '+reportForm.top+' 项' }}
												›</text></view>
									</picker>
								</view>
								<text class="group-label">实时预览</text>
								<view class="surface chart-card"><xj-chart :groups="reportPreview"
										:chart="reportForm.chart" :accent="accent"
										:count="reportForm.metric=='count'" /><text
										class="row-caption centered">{{ reportPreview.length }} 个分组 ·
										点击保存后可钻取原始记录</text></view>
								<button class="primary-btn" :style="accentBg" @click="submitReport">保存方案</button><text
									class="body-copy">金额统计不混合币种；“全部”收支金额不含转账。自定义数值仅统计已填写的有效数字，显示两位小数。</text>
							</template>

							<template v-if="page == 'report-view' && space">
								<text class="page-title">{{ reportForm.name }}</text><text
									class="body-copy">{{ reportForm.period=='all'?'全部时间':reportForm.period }} ·
									{{ metricLabels[metricOptions.indexOf(reportForm.metric)] }}</text>
								<view class="surface chart-card"><xj-chart :groups="reportPreview"
										:chart="reportForm.chart" :accent="accent"
										:count="reportForm.metric=='count'" />
									<view v-for="g in reportPreview" :key="g.name" class="setting-row"
										@click="drillInto(g,reportForm)"><text
											class="row-title grow">{{ g.name }}</text><text
											class="money-value">{{ reportForm.metric=='count'?g.value:money(g.value) }}</text><text
											class="chevron">›</text></view><text v-if="!reportPreview.length"
										class="body-copy">当前筛选条件下暂无数据。</text>
								</view>
							</template>

							<template v-if="page == 'drill' && space">
								<text class="page-title">{{ drillName }}</text><text
									class="body-copy">{{ drillRecords.length }} 条原始记录 · 与图表使用相同筛选条件</text>
								<view class="surface">
									<view v-for="t in drillRecords" :key="t.id" class="setting-row"
										@click="showCrossBookRecord(t)">
										<view class="grow"><text
												class="row-title">{{ recordTitle(currentBook(space,t.bookId),t) }}</text><text
												class="row-caption">{{ t.date }} ·
												{{ currentBook(space,t.bookId).name }}</text></view><text
											class="money-value">{{ money(t.cents) }}</text><text
											class="chevron">›</text>
									</view>
								</view>
							</template>

							<template v-if="page == 'budget' && book">
								<text class="page-title">月度预算</text>
								<view class="surface chart-card"><text class="secondary">本月已使用</text><text
										class="stats-number" :style="accentText">{{ budgetPercent }}%</text>
									<view class="progress-track">
										<view class="progress-fill"
											:style="{width:Math.min(100,budgetPercent)+'%',backgroundColor:accent}" />
									</view><text class="body-copy">{{ book.currency }} {{ money(totals.expense) }} /
										{{ money(book.budget) }}</text>
								</view><text class="group-label">设置当前账本月度预算</text>
								<view class="surface"><input v-model="budgetInput" type="digit" class="form-input"
