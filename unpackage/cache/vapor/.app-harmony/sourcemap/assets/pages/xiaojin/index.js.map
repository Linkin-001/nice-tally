									@click="saveBudget">保存预算</button><text
									v-if="book.budget>0 && totals.expense>book.budget" class="body-copy">本月已超出预算
									{{ book.currency }} {{ money(totals.expense-book.budget) }}，可以调整后续支出计划。</text>
							</template>

							<template v-if="page == 'settings' && space">
								<text class="page-title">我的</text>
								<view class="profile-row"><xj-asset name="logo" :size="58" />
									<view class="transaction-copy"><text
											class="section-title">{{ space.name }}</text><text
											class="row-caption">记录生活的你</text><text class="row-caption">完全离线 ·
											本地加密</text></view>
								</view>
						<view class="surface">
							<view class="setting-row" @click="go('books')"><text
									class="row-title grow">账本管理</text><text
									class="secondary">{{ space.books.length }} 个 ›</text></view>
									<view class="setting-row" @click="openCatalog('expense')"><text
											class="row-title grow">分类管理</text><text class="chevron">›</text></view>
									<view class="setting-row" @click="openCatalog('object')"><text
											class="row-title grow">往来对象</text><text class="chevron">›</text></view>
							<view class="setting-row" @click="go('fields')"><text
									class="row-title grow">字段配置</text><text class="chevron">›</text></view>
							<view class="setting-row" @click="go('budget')"><text
									class="row-title grow">预算管理</text><text class="chevron">›</text></view>
						</view>
								<view class="surface">
									<view class="setting-row" @click="go('theme')"><text
											class="row-title grow">主题设置</text>
										<view class="mini-swatch" :style="accentBg" /><text class="chevron">›</text>
									</view>
									<view class="setting-row" @click="go('security')"><text
											class="row-title grow">安全与隐私</text><text class="chevron">›</text></view>
									<view class="setting-row" @click="go('backup')"><text
											class="row-title grow">备份与恢复</text><text class="chevron">›</text></view>
								</view>
								<view v-if="legacyAvailable" class="surface">
									<view class="setting-row" @click="migrateLegacy"><text
											class="row-title grow">导入旧版活动账本</text><text class="chevron">›</text></view>
									<view class="setting-row" @click="openLegacy"><text
											class="row-title grow">打开旧版（原始数据保留）</text><text class="chevron">›</text>
									</view>
								</view>
								<button class="outline-btn" :style="accentText" @click="lockNow">锁定并退出</button><text
									class="footnote" @click="versionTap">小金账 2.0 · 你的数据，由你掌控</text>
							</template>

							<template v-if="page == 'theme' && space">
								<text class="page-title">选择你喜欢的颜色</text><text class="body-copy">留白与中性色，让每一笔更清晰。</text>
								<view class="surface theme-preview"><text class="secondary">本月结余</text><text
										class="balance-number" :style="{color:themeDraft}">¥ 3,268.00</text><text
										class="row-caption">主题预览 · 示例金额</text></view>
								<view class="theme-grid">
									<view v-for="c in themes" :key="c.color" class="theme-option"
										:style="{borderColor:themeDraft==c.color?c.color:'#FFFFFF'}"
										@click="themeDraft=c.color">
										<view class="theme-swatch" :style="{backgroundColor:c.color}"><text
												class="swatch-check">{{ themeDraft==c.color?'✓':'' }}</text></view><text
											class="row-title">{{ c.name }}</text>
									</view>
								</view><button class="primary-btn" :style="{backgroundColor:themeDraft}"
									@click="saveTheme">使用这个主题</button>
							</template>

							<template v-if="page == 'security' && space">
								<view class="page-intro"><xj-asset name="shield" :size="62" /><text
										class="hero-title">安全与隐私</text><text
										class="body-copy">不同密码开启不同空间，其他空间的数据和账本不可见。</text></view>
								<view class="surface">
									<view class="setting-row" @click="go('password-change')"><text
											class="row-title grow">修改空间密码</text><text class="chevron">›</text></view>
									<view class="setting-row"><text class="row-title grow">进入后台后锁定</text><text
											class="secondary">立即</text></view>
									<view class="setting-row"><text class="row-title grow">本地数据加密</text><text
											class="secondary">已启用</text></view>
									<view class="setting-row"><text class="row-title grow">生物识别</text><text
											class="secondary">暂未接入</text></view>
								</view>
								<text class="group-label">隐私空间</text>
								<view class="surface">
									<view class="setting-row" @click="beginSpace(true)"><text
											class="row-title grow">创建独立空间</text><text class="chevron">›</text></view>
									<picker v-if="space.private" :range="['输入密码','长按 Logo 后输入密码','点击版本号 5 次后输入密码']"
										@change="setEntry($event.detail.value)">
										<view class="setting-row"><text class="row-title grow">辅助入口</text><text
												class="secondary">{{ space.entry=='logo'?'长按 Logo':space.entry=='version'?'点击版本号':'输入密码' }}
												›</text></view>
									</picker>
								</view>
								<view class="notice"><text class="notice-title">退出后立即保护</text><text
										class="body-copy">锁定会清除当前页面和内存会话。Android
										启用系统安全窗口；其他平台的最近任务保护需真机确认。辅助入口始终需要密码验证。</text></view><text
									class="body-copy">请妥善保存密码。目前未启用恢复密钥，无法通过服务器找回密码。</text><button class="primary-btn"
									:style="accentBg" @click="lockNow">安全退出</button>
							</template>

							<template v-if="page == 'password-change'"><text class="group-label">当前密码</text>
								<view class="surface"><input v-model="oldPassword" password class="form-input"
										type="number" :maxlength="6" placeholder="请输入当前 6 位密码" /></view><text
									class="group-label">新密码</text>
								<view class="surface"><input v-model="newPassword" password class="form-input"
										type="number" :maxlength="6" placeholder="新的 6 位密码" /></view><text
									class="group-label">确认新密码</text>
								<view class="surface"><input v-model="confirmPassword" password class="form-input"
										type="number" :maxlength="6" placeholder="再次输入新密码" /></view><button
									class="primary-btn" :style="accentBg" :disabled="busy"
									@click="submitPassword">修改密码</button><text
									class="body-copy">旧备份仍需要备份时的密码，请在修改密码后重新导出备份。</text>
							</template>

							<template v-if="page == 'backup' && space">
								<view class="page-intro"><xj-asset name="backup" :size="62" /><text
										class="hero-title">你的数据，始终在本地</text><text
										class="body-copy">导出当前空间的加密备份，或从本地文件恢复。</text></view>
								<view class="surface">
									<view class="setting-row" @click="exportBackup">
										<view class="grow"><text class="row-title">导出加密备份</text><text
												class="row-caption">包含当前空间账本、记录、字段与统计方案</text></view><text
											class="chevron">›</text>
									</view>
									<view class="setting-row" @click="go('restore')">
										<view class="grow"><text class="row-title">从备份恢复</text><text
												class="row-caption">校验、预览后选择恢复策略</text></view><text
											class="chevron">›</text>
									</view>
									<view class="setting-row" @click="openRollback"><text
											class="row-title grow">恢复前快照回滚</text><text class="chevron">›</text></view>
								</view>
								<view v-if="exportText" class="surface transfer-panel"><text
										class="section-title">备份已生成</text><text
										class="body-copy">文件需要当前密码才能打开。请保存在安全位置。</text><textarea :value="exportText"
										class="text-area" :maxlength="-1" disabled /><button class="primary-btn"
										:style="accentBg" @click="saveBackupFile">保存备份文件</button><text
										class="text-action centered" @click="copyBackup">复制加密内容</text></view>
								<text class="body-copy">备份不会包含其他密码空间。卸载应用或清理应用数据会丢失本地记录，请保留独立备份。</text>
							</template>

							<template v-if="page == 'restore'">
								<text class="page-title">恢复本地备份</text><text
									class="body-copy">先验证文件与密码，再预览内容。检查阶段不会修改现有数据。</text><button class="outline-btn"
									:style="accentText" @click="chooseBackup">选择备份文件</button><text
									class="group-label">或粘贴完整备份内容</text><textarea v-model="importText" class="text-area"
									placeholder="粘贴小金账加密备份" :maxlength="-1" /><text class="group-label">备份密码</text>
								<view class="surface"><input v-model="backupPassword" class="form-input" password
										placeholder="输入备份时的空间密码" /></view><button class="primary-btn" :style="accentBg"
									:disabled="busy" @click="checkBackup">{{ busy?'正在校验…':'校验并预览' }}</button>
								<view v-if="importPreview" class="surface restore-preview"><text
										class="section-title">备份内容</text>
									<view class="setting-row"><text class="secondary grow">空间</text><text
											class="row-title">{{ importPreview.name }}</text></view>
									<view class="setting-row"><text class="secondary grow">账本 / 记录</text><text
											class="row-title">{{ importPreview.books.length }} /
											{{ importPreview.transactions.length }}</text></view><text
										class="body-copy">已通过密码验证与数据结构检查。</text>
									<view v-if="space" class="chips-wrap"><text class="filter-chip"
											:style="restoreMode=='merge'?accentText:{}"
											@click="restoreMode='merge'">合并当前空间</text><text class="filter-chip"
											:style="restoreMode=='replace'?accentText:{}"
											@click="restoreMode='replace'">覆盖当前空间</text></view><text v-else
										class="body-copy">创建新的数据空间，需要设置独立的 6 位密码。</text><input v-if="!space"
										v-model="restorePin" class="compact-input" type="number" password :maxlength="6"
										placeholder="新空间密码" /><button class="primary-btn" :style="accentBg"
										:disabled="busy" @click="confirmRestore">确认恢复</button><text
										class="footnote">恢复到现有空间前，自动保存加密回滚快照。</text>
								</view>
							</template>
							<view class="content-end" />
						</view>
					</scroll-view>
					<view v-if="isTab && space && !wide" class="tabbar"
						:style="{paddingBottom:Math.max(bottomInset,12)+'px'}">
						<view v-for="tab in tabs" :key="tab.page" class="tab-item" @click="switchTab(tab.page)"
							@longpress="tab.page=='settings'?lockNow():null">
							<xj-asset :name="tab.icon" :size="22"
								:tint="page==tab.page?accentSoft:'#EAEFF4'" /><text class="tab-label"
								:style="page==tab.page?accentText:{}">{{ tab.name }}</text>
						</view>
					</view>
				</view>
			</view>
		</template>

		<view v-if="sheet" class="modal-mask" @click="closeSheet">
			<view class="sheet" @click.stop="noop">
				<view class="sheet-handle" /><text class="section-title">{{ sheetTitle }}</text><text
					class="body-copy">{{ sheetCopy }}</text>
				<view v-for="option in sheetOptions" :key="option.value" class="sheet-option"
					@click="chooseSheet(option.value)"><text class="row-title"
						:style="option.danger?{color:'#DF5269'}:accentText">{{ option.label }}</text></view><input
					v-if="sheet=='delete-book' || sheet=='rollback'" v-model="confirmation" class="compact-input"
					:password="sheet=='rollback'" :placeholder="sheet=='rollback'?'输入当前密码':'输入完整账本名称'" /><button
					v-if="sheet=='delete-book' || sheet=='rollback'" class="primary-btn" :style="accentBg"
					@click="confirmDanger">{{ sheet=='rollback'?'回滚快照':'永久删除' }}</button><text v-if="sheetError"
					class="error-text">{{ sheetError }}</text><button class="cancel-btn" @click="closeSheet">取消</button>
			</view>
		</view>
		<view v-if="toastText" class="toast"><text class="toast-text">{{ toastText }}</text><text v-if="undoTransaction"
				class="toast-undo" @click="undoDelete">撤销</text></view>
	</view>
</template>

<script setup vapor lang="uts">
	import { ref, computed, onMounted, onUnmounted, watch } from 'vue'
	import * as vault from '@/common/xiaojin/vault'
	import { migrateLegacyInto } from '@/common/xiaojin/legacy'
	import { themes, fieldTypes, createBook, newTransaction, newReport, currentBook, money, cents, clone, id, nowDate, label, recordTitle, fieldVisible, saveTransaction, query, summary, aggregate, duplicateBook, removeBook, mergeSpace, validateSpace } from '@/common/xiaojin/model'
	import type { Space, Book, Transaction, Field, Entity, Report } from '@/common/xiaojin/model'

	import { randomHex, protectScreen } from '@/uni_modules/xj-security'
	vault.setEntropy(randomHex)


	const page = ref('welcome'), history = ref<string[]>([]), space = ref<Space | null>(null), bookId = ref(''), error = ref(''), busy = ref(false)
	const topInset = ref(0), bottomInset = ref(0), wide = ref(false), legacyAvailable = ref(false)
	const book = computed(() => space.value?.books.find(b => b.id === bookId.value) || null)
	const accent = computed(() => space.value?.theme || themes[0].color), accentBg = computed(() => ({ backgroundColor: accent.value })), accentText = computed(() => ({ color: accent.value })), selectedSegment = { backgroundColor: '#FFFFFF' }
	const tabs = [{ page: 'home', name: '首页', icon: 'home' }, { page: 'books', name: '账本', icon: 'book' }, { page: 'stats', name: '统计', icon: 'chart' }, { page: 'settings', name: '我的', icon: 'user' }]
	const accentSoft = computed(() => { const h = accent.value; return 'rgba(' + parseInt(h.slice(1, 3), 16) + ',' + parseInt(h.slice(3, 5), 16) + ',' + parseInt(h.slice(5, 7), 16) + ',0.12)' })
